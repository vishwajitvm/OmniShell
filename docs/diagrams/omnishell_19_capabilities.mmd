graph TD
    %% OmniShell 19 Capabilities Architecture Diagram
    User["👤 User Request (Natural Language)"] --> Router["🧠 Intent Classifier & 7-Agent Syndicate"]

    subgraph AgentSyndicate["🤖 7-Agent Syndicate Pipeline"]
        A1["1. OS Intent & Capability Analyzer"]
        A2["2. Security & Red-Line Guard"]
        A3["3. Research & Knowledge Synthesis"]
        A4["4. Execution & Workflow Planner"]
        A5["5. Scheduler & Recurrence Engine"]
        A6["6. Human Gatekeeper"]
        A7["7. Host Verification Agent"]
        
        A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7
    end
    
    Router --> AgentSyndicate
    AgentSyndicate --> CapBranch{"Capability Classifier (19 Modes)"}

    subgraph DirectKnowledge["💡 Non-Executable Knowledge Modes"]
        C1["1. Questions & Answers (Q&A)"]
        C2["2. Information Requests"]
        C4["4. Deep System Analysis"]
        C15["15. Research Tasks"]
        C16["16. Planning-Only Roadmaps"]
        C18["18. Clarification Requests"]
    end

    subgraph NativeAutomation["⚡ Host Execution Modes (Port 8003)"]
        C3["3. System Inspection"]
        C5["5. Application Operations"]
        C6["6. Browser Operations"]
        C7["7. File Operations"]
        C8["8. Shell Operations"]
        C9["9. Multi-Step Pipelines"]
        C10["10. Interactive Workflows"]
        C13["13. Conditional Workflows"]
        C14["14. Desktop Reminders"]
        C17["17. Elevated Human Approval"]
        C19["19. Failure Recovery with Rollback"]
    end

    subgraph AutonomousBackground["⏰ Background Scheduling Pipeline"]
        C11["11. Scheduled Workflows (Timestamp/Delta)"]
        C12["12. Recurring Workflows (Interval/Daily)"]
    end

    CapBranch --> DirectKnowledge
    CapBranch --> NativeAutomation
    CapBranch --> AutonomousBackground

    DirectKnowledge --> MarkdownCard["📋 Contextual Markdown Answer Card\n(Zero Shell Execution)"]
    NativeAutomation --> HumanGate{"🛡️ HITL Confirmation"}
    HumanGate -->|"Approved"| HostAgent["💻 Native Host Agent (local_executor.py)"]
    HumanGate -->|"Cancelled / Blocked"| BlockOutput["🛑 Safe Abort"]

    AutonomousBackground --> PostgresDB[("📅 PostgreSQL Scheduled Pipeline")]
    PostgresDB --> BgWorker["⚙️ Background Async Worker"]
    BgWorker -->|"Token & Time Verified"| HostAgent
    HostAgent -->|"Recurring Task Completed"| RescheduleEngine["🔁 Next Recurrence Calculator"]
    RescheduleEngine --> PostgresDB
