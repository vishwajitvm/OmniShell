graph TD
    %% ============================================================
    %% COMPLETE LEARNING, SELF-CORRECTION & FAILURE RECOVERY FLOW
    %% Demonstrates error trapping, telemetry, self-healing, and cache update
    %% ============================================================

    %% 1. User Prompt Entry
    User(["👤 User Request"]):::userClass -->|"Natural language task e.g., 'start docker engine'"| Backend["⚡ Backend API (FastAPI)"]:::backendClass

    %% 2. 8-Agent Swarm Processing
    Backend --> Swarm["🤖 8-Agent Swarm Syndicate\n(Intent → Recon → Security → Planner)"]:::agentClass
    Swarm --> CommandGen["Generated Script & Execution Payload"]:::agentClass

    %% 3. Knowledge Base & Cache Cross-Check
    CommandGen --> KBCheck{"Cross-check Redis & Known Command Base"}:::decisionClass
    KBCheck -->|"✅ Match / Cached Correction"| Override["Apply Corrected & Hardened Mapping"]:::execClass
    KBCheck -->|"❌ Uncached"| PassThru["Use Synthesized Dynamic Command"]:::agentClass

    %% 4. Execution on Native Host
    Override --> Exec["Host Execution via local_executor.py:8003"]:::hostClass
    PassThru --> Exec

    %% 5. Verification & Telemetry Inspection
    Exec --> Validate{"Validation Inspection\n1. Exit Code ($? == 0)\n2. psutil Expected Process\n3. stderr Output Analysis"}:::decisionClass

    %% 6a. Success Path
    Validate -->|"✅ SUCCESS: Clean Exit & Process Found"| Success["✅ Execution Verified\nCapture Telemetry & Metrics"]:::verifyClass
    Success --> UI["🖥️ Frontend UI & History Log"]:::uiClass
    Success --> CacheSave["💾 Store in Redis & PostgreSQL Knowledge Base"]:::dbClass

    %% 6b. Failure Path & Self-Correction
    Validate -->|"❌ FAILURE: Non-Zero Exit or Missing Process"| Failure["⚠️ Failure Detected (Non-Zero Exit / Crash)"]:::failClass
    
    subgraph SelfHealing ["🔁 Self-Healing & Failure Recovery Loop"]
        Failure --> Diagnostic["Diagnostic Analyzer\n(Inspect stderr, returncode, missing dependencies)"]:::failClass
        Diagnostic --> RecoveryAgent["Recovery & Self-Correction Agent"]:::healClass
        RecoveryAgent --> SynthesizeAlternative["Synthesize Alternative Fallback Command\n(e.g., fallback service manager or alternate binary path)"]:::healClass
        SynthesizeAlternative --> RetryExec["Retry Execution on Host (Attempt N+1)"]:::hostClass
        RetryExec --> RetryValidate{"Retry Validation"}:::decisionClass
    end

    RetryValidate -->|"✅ Retry Succeeded"| Success
    RetryValidate -->|"❌ Max Retries Reached"| UserAlert["🛑 Safe Failure Alert & User Notification"]:::failClass
    UserAlert --> UI

    %% Class Styles
    classDef userClass fill:#3b82f6,stroke:#1d4ed8,color:#ffffff,stroke-width:2px;
    classDef backendClass fill:#064e3b,stroke:#10b981,color:#ffffff,stroke-width:2px;
    classDef agentClass fill:#1e1b4b,stroke:#818cf8,color:#e0e7ff,stroke-width:1.5px;
    classDef decisionClass fill:#312e81,stroke:#a855f7,color:#ffffff,stroke-width:2px;
    classDef execClass fill:#022c22,stroke:#059669,color:#a7f3d0,stroke-width:2px;
    classDef hostClass fill:#111827,stroke:#10b981,color:#6ee7b7,stroke-width:2px;
    classDef verifyClass fill:#064e3b,stroke:#10b981,color:#ecfdf5,stroke-width:2px;
    classDef uiClass fill:#1e1b4b,stroke:#6366f1,color:#ffffff,stroke-width:2px;
    classDef dbClass fill:#1e293b,stroke:#0284c7,color:#38bdf8,stroke-width:2px;
    classDef failClass fill:#450a0a,stroke:#ef4444,color:#fee2e2,stroke-width:2px;
    classDef healClass fill:#3b0764,stroke:#c084fc,color:#fae8ff,stroke-width:2px;
