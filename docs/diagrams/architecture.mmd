graph TD
    %% User & Frontend Interface
    User(["👤 User Prompt"]):::userClass --> UI["🖥️ Frontend UI (NestJS + Handlebars)"]:::uiClass
    
    subgraph ControlPlane ["🎛️ Request Control Plane (Intent → Policy → Plan → Execute → Verify)"]
        UI --> CP_Intent["1. Intent Analysis\n(Confidence & Signals)"]:::cpClass
        CP_Intent --> CP_Policy["2. Policy & Safety Gate\n(AST & Risk Check)"]:::cpClass
        CP_Policy --> CP_Plan["3. Workflow Planning\n(8-Agent Syndicate)"]:::cpClass
        CP_Plan --> CP_Execute["4. Host Execution\n(Local Daemon / Browser)"]:::cpClass
        CP_Execute --> CP_Verify["5. Output Verification\n(Exit Code & Process)"]:::cpClass
    end

    %% Backend API Routing
    CP_Intent --> Backend["⚡ Backend API (FastAPI)"]:::backendClass

    %% Persistence & Telemetry
    Backend -.-> DB[("🐘 PostgreSQL\n(Scheduled Tasks & Audit Logs)")]:::dbClass
    Backend -.-> Cache[("🔴 Redis Cache\n(Learned Commands & Worker Queue)")]:::cacheClass

    %% 8-Agent Swarm Syndicate
    subgraph AgentSyndicate ["🤖 OmniShell 8-Agent Swarm Syndicate"]
        Backend --> A1["1. Intent & Planning Agent\n(Deconstructs Prompt & Mapped Capability)"]:::agentClass
        A1 --> A2["2. System Reconnaissance Agent\n(Host OS, Shell & Binary Path Probes)"]:::agentClass
        A2 --> A3["3. Content & Knowledge Synthesizer\n(Contextual Dossier & Direct Answers)"]:::agentClass
        A3 --> A4["4. Security Guard\n(Prohibited AST & Risk Evaluation)"]:::agentClass
        A4 --> A5["5. Safety & Policy Supervisor\n(Boundary Enforcement & Safety Level)"]:::agentClass
        A5 --> A6["6. Command Research Agent\n(System Interfaces & Native Synthesizer)"]:::agentClass
        A6 --> A7["7. Command Validator Agent\n(Shell Quoting & Exit Code Verification)"]:::agentClass
        A7 --> A8["8. Execution Planner\n(Pipeline Routing & Execution Mode)"]:::agentClass
        
        A5 -.->|"Ambiguous / Missing Target"| ClarifyAgent["❓ Clarification Agent\n(Contextual Disambiguation Options)"]:::clarifyClass
    end

    %% Routing & Gatekeeper Decisions
    A8 --> Decision{"Execution Mode?"}:::decisionClass

    %% Branches
    Decision -->|"Q&A / Info / Plan"| DirectAns["💡 Markdown Answer Card\n(Direct Delivery, Zero Host Execution)"]:::infoClass
    Decision -->|"Web Navigation"| BrowserFlow["🌐 Browser Dispatch & Picker"]:::browserClass
    Decision -->|"Immediate Host Action"| ApprovalCheck{"Requires Approval?"}:::decisionClass
    Decision -->|"Scheduled / Recurring"| SchedQueue["⏰ PostgreSQL Task Queue\n(Background Scheduler Worker)"]:::schedClass

    %% Dual Approval Paths
    ApprovalCheck -->|"Destructive / Elevated"| ModalApprove["🔒 In-UI Confirmation Modal\n(Command Preview & Authorize)"]:::approvalClass
    ApprovalCheck -->|"Safe / Read-Only"| AutoExec["⚡ Direct Execution Dispatch"]:::execClass
    
    SchedQueue -->|"Trigger Due"| WindowDoc["📄 Pop-out Approval Window Document\n(/scheduled-approval/:token)"]:::windowClass

    %% Native Host Daemon Execution
    subgraph HostEnv ["💻 Native Host Environment (localhost:8003)"]
        ModalApprove -->|"Authorized"| HostDaemon["⚡ Local Host Executor (local_executor.py)\n(Persistent Detached Session)"]:::hostClass
        WindowDoc -->|"Approved"| HostDaemon
        AutoExec --> HostDaemon
        BrowserFlow --> HostDaemon

        HostDaemon --> LinuxRunner["🐧 Linux Bash (/bin/bash)"]:::osClass
        HostDaemon --> MacRunner["🍎 macOS Zsh (/bin/zsh)"]:::osClass
        HostDaemon --> WinRunner["🪟 Windows PowerShell (pwsh)"]:::osClass

        LinuxRunner --> Subprocess["⚙️ Subprocess Pipeline\n(stdout / stderr capture & process probe)"]:::execClass
        MacRunner --> Subprocess
        WinRunner --> Subprocess
    end

    %% Lifecycle Return
    Subprocess --> Validation["✅ Exit Code ($? == 0) & Process Hierarchy Validation"]:::verifyClass
    Validation --> UI

    %% Styling
    classDef userClass fill:#3b82f6,stroke:#1d4ed8,color:#ffffff,stroke-width:2px;
    classDef uiClass fill:#1e1b4b,stroke:#6366f1,color:#ffffff,stroke-width:2px;
    classDef cpClass fill:#0f172a,stroke:#38bdf8,color:#38bdf8,stroke-width:1.5px;
    classDef backendClass fill:#064e3b,stroke:#10b981,color:#ffffff,stroke-width:2px;
    classDef dbClass fill:#1e293b,stroke:#0284c7,color:#38bdf8,stroke-width:2px;
    classDef cacheClass fill:#1e293b,stroke:#ef4444,color:#f87171,stroke-width:2px;
    classDef agentClass fill:#1e1b4b,stroke:#818cf8,color:#e0e7ff,stroke-width:1.5px;
    classDef clarifyClass fill:#451a03,stroke:#f59e0b,color:#fde68a,stroke-width:2px;
    classDef decisionClass fill:#312e81,stroke:#a855f7,color:#ffffff,stroke-width:2px;
    classDef infoClass fill:#064e3b,stroke:#34d399,color:#ecfdf5,stroke-width:2px;
    classDef browserClass fill:#0c4a6e,stroke:#38bdf8,color:#e0f2fe,stroke-width:2px;
    classDef schedClass fill:#3b0764,stroke:#c084fc,color:#fae8ff,stroke-width:2px;
    classDef approvalClass fill:#451a03,stroke:#f59e0b,color:#fef3c7,stroke-width:2px;
    classDef windowClass fill:#1e1b4b,stroke:#a855f7,color:#f3e8ff,stroke-width:2px;
    classDef hostClass fill:#111827,stroke:#10b981,color:#6ee7b7,stroke-width:2px;
    classDef osClass fill:#1e293b,stroke:#64748b,color:#f1f5f9,stroke-width:1.5px;
    classDef execClass fill:#022c22,stroke:#059669,color:#a7f3d0,stroke-width:2px;
    classDef verifyClass fill:#064e3b,stroke:#10b981,color:#ecfdf5,stroke-width:2px;
