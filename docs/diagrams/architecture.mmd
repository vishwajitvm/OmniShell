graph TD;
    %% ============================================================
    %% 7-AGENT MULTI-AGENT SYNDICATE ARCHITECTURE
    %% With 4-Layer Defense and V2 Executor
    %% ============================================================

    User((User)) -->|"Natural Language Prompt"| UI[Frontend UI - NestJS];
    
    UI -->|"HTTP POST"| Layer0{"Layer 0: Pre-LLM Regex Guardrail (Backend)"};
    Layer0 -->|"Malicious Pattern"| Block["BLOCKED"];
    Layer0 -->|"Safe"| Backend[Backend API - FastAPI];

    %% Infrastructure
    Backend -.->|"Logs"| TraceNest[(TraceNest Logger)];

    %% 7-Agent Swarm
    subgraph Agent Swarm - The Syndicate
        Backend --> IntentPlan["1. Intent & Planning"];
        IntentPlan --> SysRecon["2. System Reconnaissance"];
        SysRecon --> ContentGen["3. Content Generation"];
        ContentGen --> SecGuard["4. Security Guard (Layer 1)"];
        SecGuard --> ResearchAgent["5. Command Research"];
        ResearchAgent --> Critic["6. Command Validator (Critic)"];
        Critic -->|"Rejects Draft"| ResearchAgent;
        Critic -->|"Approves Draft"| ExecPlanner["7. Execution Planner"];
    end

    %% Security Gate
    SecGuard -->|"Malicious Intent"| Block;

    %% 3-Tier Command Resolution
    subgraph 3-Tier Command Resolution
        ExecPlanner --> Tier1{"Tier 1: Redis Cache"};
        Tier1 -->|"Cache HIT"| Resolved["Use Cached Command"];
        Tier1 -->|"Cache MISS"| Tier2{"Tier 2: KNOWN_APP_COMMANDS"};
        Tier2 -->|"Match Found"| Resolved;
        Tier2 -->|"No Match"| Tier3["Tier 3: Research Agent"];
        Tier3 -->|"DuckDuckGo Search"| WebSearch["Web Search Results"];
        WebSearch -->|"LLM Extraction"| ExtractCmd["Extract Correct Command"];
        ExtractCmd --> Resolved;
        ExtractCmd -->|"Learn for next time"| Redis[(Redis Cache)];
    end

    %% Execution Routing
    Resolved -->|"Web URL"| WebTask["requires_browser = True"];
    Resolved -->|"Local App"| LocalTask["shell_script = Correct Command"];

    WebTask --> Layer2{"Layer 2: Frontend Double-Confirmation"};
    LocalTask --> Layer2;
    
    Layer2 -->|"Approved"| Layer3{"Layer 3: Frontend Regex Override"};
    Layer3 -->|"Malicious Script"| Block;
    Layer3 -->|"Safe"| DockerBridge{"Docker-to-Host Bridge"};

    %% Host Execution
    subgraph Native Host Machine
        DockerBridge -->|"Port 8003"| LocalExecutor["Host Executor V2 (local_executor.py)"];
        LocalExecutor -->|"Web Task"| OpenBrowser["Launch Browser Native"];
        LocalExecutor -->|"Local Task"| Subprocess["subprocess.Popen Background Job"];
        Subprocess --> Validation["psutil Validation & stdout/stderr Capture"];
        OpenBrowser --> Validation;
    end

    %% Feedback Loop
    Validation -->|"Success"| StoreSuccess["Store in Redis + PostgreSQL"];
    Validation -->|"Failure"| LogFailure["Log for future training"];
    Validation -->|"Result"| UI;

    %% Styling
    style User fill:#4CAF50,stroke:#2E7D32,color:#fff;
    style Layer0 fill:#F44336,stroke:#B71C1C,color:#fff;
    style Layer2 fill:#FF9800,stroke:#E65100,color:#fff;
    style Layer3 fill:#F44336,stroke:#B71C1C,color:#fff;
    style Critic fill:#9C27B0,stroke:#4A148C,color:#fff;
    style ResearchAgent fill:#FF9800,stroke:#E65100,color:#fff;
    style Tier1 fill:#E91E63,stroke:#880E4F,color:#fff;
    style Tier2 fill:#2196F3,stroke:#1565C0,color:#fff;
    style Tier3 fill:#FF9800,stroke:#E65100,color:#fff;
    style Redis fill:#E91E63,stroke:#880E4F,color:#fff;
    style Resolved fill:#4CAF50,stroke:#2E7D32,color:#fff;
    style Block fill:#F44336,stroke:#B71C1C,color:#fff;
    style StoreSuccess fill:#4CAF50,stroke:#2E7D32,color:#fff;
    style LogFailure fill:#F44336,stroke:#B71C1C,color:#fff;
