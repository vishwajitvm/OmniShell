graph TD
    %% ============================================================
    %% SELF-LEARNING PIPELINE - MULTI-TIER KNOWLEDGE & RESILIENCE
    %% Real example: Dynamic binary resolution & continuous caching
    %% ============================================================

    %% === TIER 1: CACHED FAST PATH ===
    subgraph Tier1 ["⚡ Fast Path: In-Memory Redis Knowledge Tier"]
        U1(["👤 User Prompt"]):::userClass -->|"1. 'open vs code'"| RedisCheck{"Tier 1: Redis Key Check\n('app:vscode' / 'cmd:vscode')"}:::decisionClass
        RedisCheck -->|"✅ Cache HIT (<1ms)"| FastExec["🚀 Instant Resolution\n(Skip LLM Pipeline)"]:::execClass
        FastExec --> DirectHost["Execute via local_executor.py\n('code' or 'code .')"]:::hostClass
    end

    %% === TIER 2: STATIC KNOWLEDGE BASE & SYSTEM RECONNAISSANCE ===
    subgraph Tier2 ["🧠 Tier 2: Static Knowledge Base & System Reconnaissance Agent"]
        RedisCheck -->|"❌ Cache MISS"| Swarm["🤖 8-Agent Swarm Syndicate"]:::agentClass
        Swarm --> Recon["System Reconnaissance Agent\n(Scans OS PATH & which/where probes)"]:::agentClass
        Recon --> KB{"Known Application Registry"}:::decisionClass
        KB -->|"✅ Found Known Binary Alias"| SynthesizeCmd["Synthesize Resilient Command\n(e.g., 'command -v code && code')"]:::execClass
        SynthesizeCmd --> HostRun1["Host Execution Attempt"]:::hostClass
        HostRun1 --> Validate1{"psutil Process & Exit Code Validation"}:::decisionClass
        Validate1 -->|"✅ Process Running / Exit 0"| CacheStore["💾 Store in Redis & PostgreSQL\n(Future Instant Hits)"]:::dbClass
    end

    %% === TIER 3: AUTONOMOUS RESEARCH AGENT ===
    subgraph Tier3 ["🔬 Tier 3: Autonomous Web Research Agent (DuckDuckGo Search)"]
        KB -->|"❌ Unknown App / Obscure Binary"| ResAgent["Command Research Agent"]:::agentClass
        ResAgent --> DDG["🌐 Autonomous Search API\n('how to launch <app> from CLI on Linux/macOS/Windows')"]:::researchClass
        DDG --> Extract["Extract CLI invocation pattern from search snippets"]:::agentClass
        Extract --> SecAudit["Security Guard AST & Flag Audit"]:::secClass
        SecAudit --> HostRun2["Execute Researched Command on Host"]:::hostClass
        HostRun2 --> Validate2{"psutil & Process Hierarchy Validation"}:::decisionClass
        Validate2 -->|"✅ Success"| CacheStore2["💾 Permanently Learn & Cache in Redis"]:::dbClass
        Validate2 -->|"❌ Failed"| SelfHeal["🔁 Trigger Self-Healing & Failure Recovery Agent"]:::healClass
    end

