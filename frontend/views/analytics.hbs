<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} — OmniShell Telemetry & Model Analytics</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background: radial-gradient(circle at top, #1e1b4b 0%, #090d16 50%, #020617 100%);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }
        .glass-card {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(148, 163, 184, 0.12);
        }
        .glass-card:hover {
            border-color: rgba(99, 102, 241, 0.35);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.3);
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.6);
        }
    </style>
</head>
<body class="min-h-screen text-slate-100 p-4 sm:p-8">
    <main class="max-w-7xl mx-auto space-y-7">

        <!-- Top Header & Navigation -->
        <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 pb-2 border-b border-slate-800/80">
            <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    OmniShell / Telemetry & Observability
                </div>
                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-indigo-300">
                    Reliability & Model Analytics
                </h1>
                <p class="text-slate-400 text-sm mt-1 max-w-3xl leading-relaxed">
                    Real-time multi-agent execution telemetry, token economics, fallback health, latency breakdown, and execution audit trails.
                </p>
            </div>
            
            <div class="flex items-center gap-3 shrink-0">
                <span id="live-indicator" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900 border border-slate-800 text-xs text-slate-400 font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span id="refresh-time">live sync</span>
                </span>
                <a href="/" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition shadow-lg shadow-indigo-600/30 flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                    Command Center
                </a>
                <a href="/pipeline" class="px-4 py-2 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-semibold transition border border-slate-700 flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                    Pipeline Dashboard
                </a>
            </div>
        </header>

        <!-- KPI Metrics Grid -->
        <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
            <div class="glass-card rounded-2xl p-4 shadow-xl relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-indigo-500/10 rounded-full blur-xl group-hover:bg-indigo-500/20 transition"></div>
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Total Requests</div>
                <div id="k-requests" class="text-2xl sm:text-3xl font-black text-white mt-1">0</div>
                <div class="text-[10px] text-emerald-400 mt-1 flex items-center gap-1">
                    <span>⚡ Real-time stream</span>
                </div>
            </div>

            <div class="glass-card rounded-2xl p-4 shadow-xl relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-violet-500/10 rounded-full blur-xl group-hover:bg-violet-500/20 transition"></div>
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Tokens Consumed</div>
                <div id="k-tokens" class="text-2xl sm:text-3xl font-black text-violet-300 mt-1">0</div>
                <div id="k-tokens-sub" class="text-[10px] text-slate-400 mt-1 truncate">Prompt + Comp</div>
            </div>

            <div class="glass-card rounded-2xl p-4 shadow-xl relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-emerald-500/10 rounded-full blur-xl group-hover:bg-emerald-500/20 transition"></div>
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Success Rate</div>
                <div id="k-success" class="text-2xl sm:text-3xl font-black text-emerald-300 mt-1">100%</div>
                <div class="text-[10px] text-slate-400 mt-1">Guarded operations</div>
            </div>

            <div class="glass-card rounded-2xl p-4 shadow-xl relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-cyan-500/10 rounded-full blur-xl group-hover:bg-cyan-500/20 transition"></div>
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Avg LLM Reasoning</div>
                <div id="k-latency" class="text-2xl sm:text-3xl font-black text-cyan-300 mt-1">0.0s</div>
                <div class="text-[10px] text-slate-400 mt-1">Synthesizing speed</div>
            </div>

            <div class="glass-card rounded-2xl p-4 shadow-xl relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-amber-500/10 rounded-full blur-xl group-hover:bg-amber-500/20 transition"></div>
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Fallbacks Active</div>
                <div id="k-fallbacks" class="text-2xl sm:text-3xl font-black text-amber-300 mt-1">0</div>
                <div class="text-[10px] text-slate-400 mt-1">Cascaded models</div>
            </div>

            <div class="glass-card rounded-2xl p-4 shadow-xl relative overflow-hidden group">
                <div class="absolute -right-2 -bottom-2 w-16 h-16 bg-rose-500/10 rounded-full blur-xl group-hover:bg-rose-500/20 transition"></div>
                <div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Failure / Blocked</div>
                <div id="k-failures" class="text-2xl sm:text-3xl font-black text-rose-300 mt-1">0%</div>
                <div class="text-[10px] text-slate-400 mt-1">Intercepted threats</div>
            </div>
        </section>

        <!-- Interactive Filter Control Bar -->
        <section class="glass-card rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3 shadow-lg">
            <div class="flex flex-wrap items-center gap-3 flex-1">
                <div class="relative min-w-[140px]">
                    <select id="filter-time" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-200 outline-none focus:border-indigo-500 transition cursor-pointer">
                        <option value="all">All Time History</option>
                        <option value="today">Today (24h)</option>
                        <option value="week">Last 7 Days</option>
                        <option value="month">Last 30 Days</option>
                    </select>
                </div>

                <div class="relative min-w-[150px]">
                    <select id="filter-provider" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-200 outline-none focus:border-indigo-500 transition cursor-pointer">
                        <option value="all">All AI Providers</option>
                    </select>
                </div>

                <div class="relative min-w-[180px]">
                    <select id="filter-model" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-200 outline-none focus:border-indigo-500 transition cursor-pointer">
                        <option value="all">All Model Architectures</option>
                    </select>
                </div>

                <div class="relative flex-1 min-w-[200px]">
                    <input id="filter-search" type="text" placeholder="Search execution prompts, capabilities, errors..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-200 outline-none focus:border-indigo-500 transition" />
                </div>
            </div>

            <button onclick="loadAnalytics()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-medium border border-slate-700 transition flex items-center gap-1.5 cursor-pointer">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                Refresh Data
            </button>
        </section>

        <!-- Charts Section (2 Columns) -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            <!-- Token & Request Dynamics Line Chart -->
            <div class="glass-card rounded-3xl p-6 shadow-2xl flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <span>📈</span> Token & Request Volume Dynamics
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Timeline token usage and load frequency</p>
                    </div>
                    <span id="chart-total-label" class="text-xs font-mono px-2.5 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300"></span>
                </div>
                <div class="relative w-full h-[280px]">
                    <canvas id="usage-chart"></canvas>
                </div>
            </div>

            <!-- Reliability & Outcomes Doughnut Chart -->
            <div class="glass-card rounded-3xl p-6 shadow-2xl flex flex-col justify-between">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <span>🎯</span> Reliability & Execution Outcome Split
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Ratio of successful completions, recovery loops & blocked threats</p>
                    </div>
                    <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300">Guarded Policy</span>
                </div>
                <div class="relative w-full h-[280px] flex items-center justify-center">
                    <canvas id="outcome-chart"></canvas>
                </div>
            </div>
        </section>

        <!-- Fallback Chain Cascade & Capability Distribution -->
        <section class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            <!-- Multi-Tier Fallback Chain Topology -->
            <div class="glass-card rounded-3xl p-6 shadow-2xl flex flex-col">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <span>🔗</span> Multi-Tier Autonomous Fallback Chain
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Cascading failover sequence across OpenRouter, NVIDIA NIM, and Gemini engines</p>
                    </div>
                    <span id="chain-count" class="text-xs font-mono px-2.5 py-1 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold">16 Models</span>
                </div>

                <div id="fallback-chain-container" class="space-y-2 max-h-72 overflow-y-auto pr-1 custom-scrollbar">
                    <div class="text-slate-500 text-xs italic">Loading fallback models...</div>
                </div>
            </div>

            <!-- Capabilities Usage Breakdown -->
            <div class="glass-card rounded-3xl p-6 shadow-2xl flex flex-col">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <span>⚙️</span> Capability Usage Distribution
                        </h2>
                        <p class="text-xs text-slate-400 mt-0.5">Execution volume across the 19 core OmniShell capabilities</p>
                    </div>
                    <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold">19 Cap Matrix</span>
                </div>

                <div id="capability-distribution-container" class="space-y-2.5 max-h-72 overflow-y-auto pr-1 custom-scrollbar">
                    <div class="text-slate-500 text-xs italic">Calculating capability usage...</div>
                </div>
            </div>
        </section>

        <!-- Live Execution Audit Log Table with Interactive Inspection -->
        <section class="glass-card rounded-3xl overflow-hidden shadow-2xl">
            <div class="p-6 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center gap-2">
                        <span>📋</span> Recent Execution Audit & Telemetry Log
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">Latest requests on top. Click any row or Inspect button to view live execution outputs, direct answers, generated scripts & swarm thoughts.</p>
                </div>
                <div class="flex items-center gap-2">
                    <span id="log-count-badge" class="text-xs font-mono px-3 py-1 bg-slate-900 border border-slate-800 text-slate-400 rounded-xl">0 Records</span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-950/80 text-[10px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="p-4 font-semibold">ID / Timestamp</th>
                            <th class="p-4 font-semibold">Prompt Request</th>
                            <th class="p-4 font-semibold">Capability</th>
                            <th class="p-4 font-semibold">Model Used</th>
                            <th class="p-4 font-semibold">Latency</th>
                            <th class="p-4 font-semibold">Status</th>
                            <th class="p-4 font-semibold text-right">Details & Output</th>
                        </tr>
                    </thead>
                    <tbody id="execution-logs-body" class="divide-y divide-slate-800/60 text-xs">
                        <tr>
                            <td colspan="7" class="p-8 text-center text-slate-500 italic">Loading execution audit log...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <script>
        let rawAnalytics = [];
        let fallbackFlow = [];
        let executionLogs = [];
        let usageChartInstance = null;
        let outcomeChartInstance = null;
        let expandedLogIds = new Set();

        const ONE_DAY = 24 * 60 * 60;

        const esc = str => String(str ?? '').replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c]));

        async function loadAnalytics() {
            try {
                const res = await fetch('http://localhost:8000/api/analytics');
                if (!res.ok) throw new Error('Backend analytics unavailable');
                const json = await res.json();
                rawAnalytics = json.data || [];
                fallbackFlow = json.fallback_flow || [];
                // Sort by ID descending so the latest request is always on top
                executionLogs = (json.execution_history || []).sort((a, b) => (Number(b.id) || 0) - (Number(a.id) || 0));
                
                populateFilterDropdowns();
                renderAll();
                document.getElementById('refresh-time').innerText = 'updated ' + new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'});
            } catch (err) {
                document.getElementById('refresh-time').innerText = 'offline';
            }
        }

        function populateFilterDropdowns() {
            const providers = [...new Set(rawAnalytics.map(x => x.provider).filter(Boolean))];
            const models = [...new Set(rawAnalytics.map(x => x.model).filter(Boolean))];

            const provSelect = document.getElementById('filter-provider');
            const modSelect = document.getElementById('filter-model');

            // Preserve selections
            const currProv = provSelect.value;
            const currMod = modSelect.value;

            provSelect.innerHTML = '<option value="all">All AI Providers</option>' + providers.map(p => `<option value="${p}">${p.toUpperCase()}</option>`).join('');
            modSelect.innerHTML = '<option value="all">All Model Architectures</option>' + models.map(m => `<option value="${m}">${m}</option>`).join('');

            if (providers.includes(currProv)) provSelect.value = currProv;
            if (models.includes(currMod)) modSelect.value = currMod;
        }

        function getFilteredData() {
            const timeFilter = document.getElementById('filter-time').value;
            const providerFilter = document.getElementById('filter-provider').value;
            const modelFilter = document.getElementById('filter-model').value;
            const searchFilter = document.getElementById('filter-search').value.toLowerCase().trim();
            const nowSec = Date.now() / 1000;

            return rawAnalytics.filter(item => {
                const matchProv = (providerFilter === 'all' || item.provider === providerFilter);
                const matchMod = (modelFilter === 'all' || item.model === modelFilter);
                
                let matchTime = true;
                if (timeFilter === 'today') matchTime = (nowSec - item.timestamp < ONE_DAY);
                else if (timeFilter === 'week') matchTime = (nowSec - item.timestamp < ONE_DAY * 7);
                else if (timeFilter === 'month') matchTime = (nowSec - item.timestamp < ONE_DAY * 30);

                let matchSearch = true;
                if (searchFilter) {
                    const text = `${item.model} ${item.provider} ${item.error || ''}`.toLowerCase();
                    matchSearch = text.includes(searchFilter);
                }

                return matchProv && matchMod && matchTime && matchSearch;
            });
        }

        function renderAll() {
            const filteredData = getFilteredData();
            renderKPIs(filteredData);
            renderCharts(filteredData);
            renderFallbackChain();
            renderCapabilityDistribution();
            renderExecutionLogsTable();
        }

        function renderKPIs(data) {
            const totalRequests = data.length;
            const promptTokens = data.reduce((acc, cur) => acc + (cur.prompt_tokens || 0), 0);
            const compTokens = data.reduce((acc, cur) => acc + (cur.completion_tokens || 0), 0);
            const totalTokens = promptTokens + compTokens;

            const successful = data.filter(d => d.success !== false).length;
            const successRate = totalRequests > 0 ? Math.round((successful / totalRequests) * 100) : 100;
            const failureCount = totalRequests - successful;
            const failureRate = totalRequests > 0 ? ((failureCount / totalRequests) * 100).toFixed(1) : '0.0';

            // Calculate latency average from execution logs
            const latencies = executionLogs.map(l => l.timing && l.timing.llm_reasoning).filter(Boolean);
            const avgLatency = latencies.length > 0 ? (latencies.reduce((a,b)=>a+b,0) / latencies.length).toFixed(2) : '0.45';

            // Count fallbacks used
            const fallbacksUsed = data.filter(d => d.model && !d.model.includes('llama-3.3-70b')).length;

            document.getElementById('k-requests').innerText = totalRequests.toLocaleString();
            document.getElementById('k-tokens').innerText = totalTokens > 1000000 ? `${(totalTokens/1000000).toFixed(2)}M` : `${(totalTokens/1000).toFixed(1)}k`;
            document.getElementById('k-tokens-sub').innerText = `${promptTokens.toLocaleString()} in / ${compTokens.toLocaleString()} out`;
            document.getElementById('k-success').innerText = `${successRate}%`;
            document.getElementById('k-latency').innerText = `${avgLatency}s`;
            document.getElementById('k-fallbacks').innerText = fallbacksUsed;
            document.getElementById('k-failures').innerText = `${failureRate}%`;
        }

        function renderCharts(data) {
            // Group data by hourly / 10-minute buckets for timeline chart
            const buckets = {};
            data.forEach(item => {
                const date = new Date(item.timestamp * 1000);
                const key = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                if (!buckets[key]) buckets[key] = { tokens: 0, count: 0 };
                buckets[key].tokens += (item.total_tokens || 0);
                buckets[key].count += 1;
            });

            const labels = Object.keys(buckets).slice(-12);
            const tokenData = labels.map(k => buckets[k].tokens);
            const countData = labels.map(k => buckets[k].count);

            const totalTokensInRange = tokenData.reduce((a, b) => a + b, 0);
            document.getElementById('chart-total-label').innerText = `${totalTokensInRange.toLocaleString()} Tokens Logged`;

            const successfulCount = data.filter(d => d.success !== false).length;
            const failureCount = data.filter(d => d.success === false).length;

            // Usage Dynamics Chart
            const usageCanvas = document.getElementById('usage-chart');
            if (usageChartInstance) usageChartInstance.destroy();
            usageChartInstance = new Chart(usageCanvas, {
                type: 'line',
                data: {
                    labels: labels.length ? labels : ['Ready'],
                    datasets: [
                        {
                            label: 'Tokens Consumed',
                            data: tokenData.length ? tokenData : [0],
                            borderColor: '#818cf8',
                            backgroundColor: 'rgba(99, 102, 241, 0.15)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2,
                            pointBackgroundColor: '#6366f1',
                            pointRadius: 4,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Requests Count',
                            data: countData.length ? countData : [0],
                            borderColor: '#38bdf8',
                            backgroundColor: 'transparent',
                            borderDash: [4, 4],
                            borderWidth: 2,
                            pointBackgroundColor: '#38bdf8',
                            pointRadius: 3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { labels: { color: '#cbd5e1', font: { size: 11 } } },
                        tooltip: { backgroundColor: '#0f172a', borderColor: '#334155', borderWidth: 1 }
                    },
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8', font: { size: 10 } } },
                        y: { position: 'left', grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#818cf8', font: { size: 10 } } },
                        y1: { position: 'right', grid: { drawOnChartArea: false }, ticks: { color: '#38bdf8', font: { size: 10 } } }
                    }
                }
            });

            // Outcome Doughnut Chart
            const outcomeCanvas = document.getElementById('outcome-chart');
            if (outcomeChartInstance) outcomeChartInstance.destroy();
            outcomeChartInstance = new Chart(outcomeCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Successful Guarded Ops', 'Intercepted / Failed'],
                    datasets: [{
                        data: [successfulCount || 1, failureCount],
                        backgroundColor: ['#10b981', '#f43f5e'],
                        borderColor: '#0f172a',
                        borderWidth: 4,
                        hoverOffset: 6
                    }]
                },
                options: {
                    cutout: '72%',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#cbd5e1', font: { size: 11 }, padding: 16 } },
                        tooltip: { backgroundColor: '#0f172a', borderColor: '#334155', borderWidth: 1 }
                    }
                }
            });
        }

        function renderFallbackChain() {
            const container = document.getElementById('fallback-chain-container');
            document.getElementById('chain-count').innerText = `${fallbackFlow.length} Models`;

            if (!fallbackFlow || fallbackFlow.length === 0) {
                container.innerHTML = '<div class="text-slate-500 text-xs italic">No fallback models configured.</div>';
                return;
            }

            container.innerHTML = fallbackFlow.map((model, idx) => {
                const isPrimary = idx === 0;
                const isSecondary = idx < 3;
                const tier = isPrimary ? 'Primary Active' : (isSecondary ? 'High Priority' : 'Emergency Backup');
                const tierColor = isPrimary ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30' : (isSecondary ? 'text-indigo-300 bg-indigo-500/10 border-indigo-500/30' : 'text-slate-400 bg-slate-900 border-slate-800');
                const provider = model.split('/')[0] || 'engine';

                return `
                    <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800/80 hover:border-slate-700 flex items-center justify-between gap-3 text-xs transition">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="w-5 h-5 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-[10px] font-mono text-slate-400 shrink-0">
                                ${idx + 1}
                            </span>
                            <div class="truncate">
                                <span class="font-mono text-slate-200 font-medium">${esc(model)}</span>
                                <span class="ml-2 text-[10px] text-slate-500 font-mono uppercase">(${esc(provider)})</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-mono font-semibold shrink-0 ${tierColor}">
                            ${tier}
                        </span>
                    </div>
                `;
            }).join('');
        }

        function renderCapabilityDistribution() {
            const container = document.getElementById('capability-distribution-container');
            const capCounts = {};

            executionLogs.forEach(l => {
                const cap = l.capability_type || 'shell_operation';
                capCounts[cap] = (capCounts[cap] || 0) + 1;
            });

            // Ensure baseline capabilities are visible
            const keys = Object.keys(capCounts).length > 0 ? Object.keys(capCounts) : [
                'question_answering', 'browser_operation', 'system_inspection', 'multi_step', 'recurring_workflow', 'reminder'
            ];

            const totalLogs = executionLogs.length || 1;
            const sortedCaps = keys.sort((a,b) => (capCounts[b] || 0) - (capCounts[a] || 0));

            container.innerHTML = sortedCaps.map(cap => {
                const count = capCounts[cap] || 0;
                const pct = Math.round((count / totalLogs) * 100) || 5;
                const formattedName = cap.replace(/_/g, ' ').toUpperCase();

                return `
                    <div class="bg-slate-950/70 p-3 rounded-xl border border-slate-800/80">
                        <div class="flex justify-between items-center text-xs mb-1.5">
                            <span class="font-mono text-slate-300 font-medium">${formattedName}</span>
                            <span class="text-xs font-mono text-indigo-400 font-bold">${count} runs</span>
                        </div>
                        <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden border border-slate-800">
                            <div class="h-full bg-gradient-to-r from-indigo-500 to-cyan-400 rounded-full transition-all duration-500" style="width: ${pct}%;"></div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleLogDetails(logId) {
            const row = document.getElementById(`detail-row-${logId}`);
            const btn = document.getElementById(`toggle-btn-${logId}`);
            if (!row) return;

            if (row.classList.contains('hidden')) {
                row.classList.remove('hidden');
                expandedLogIds.add(logId);
                if (btn) btn.innerHTML = `▲ Close`;
            } else {
                row.classList.add('hidden');
                expandedLogIds.delete(logId);
                if (btn) btn.innerHTML = `▼ Inspect`;
            }
        }

        function copyToClipboard(text, btnId) {
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.getElementById(btnId);
                if (btn) {
                    const orig = btn.innerText;
                    btn.innerText = "✓ Copied!";
                    setTimeout(() => { btn.innerText = orig; }, 1500);
                }
            });
        }

        function renderExecutionLogsTable() {
            const tbody = document.getElementById('execution-logs-body');
            const countBadge = document.getElementById('log-count-badge');
            const search = document.getElementById('filter-search').value.toLowerCase().trim();

            const filteredLogs = executionLogs.filter(log => {
                if (!search) return true;
                const combined = `${log.prompt} ${log.model_used} ${log.capability_type} ${log.id} ${log.shell_script || ''} ${log.direct_answer || ''}`.toLowerCase();
                return combined.includes(search);
            });

            countBadge.innerText = `${filteredLogs.length} Records`;

            if (filteredLogs.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="p-8 text-center text-slate-500 italic">
                            No execution logs match the current filters.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filteredLogs.map(log => {
                const dateStr = log.created_at ? new Date(log.created_at).toLocaleString([], {month:'short', day:'numeric', hour: '2-digit', minute:'2-digit', second:'2-digit'}) : '—';
                const capType = log.capability_type || 'shell_operation';
                const isSafe = log.is_safe !== false;
                const latency = log.timing && log.timing.total ? `${Number(log.timing.total).toFixed(2)}s` : (log.timing && log.timing.llm_reasoning ? `${Number(log.timing.llm_reasoning).toFixed(2)}s` : '0.45s');
                const model = log.model_used || 'OpenRouter Llama 3.3';
                const isExpanded = expandedLogIds.has(log.id);

                const directAnswer = log.direct_answer || (log.raw_response && log.raw_response.direct_answer);
                const shellScript = log.shell_script || (log.raw_response && log.raw_response.shell_script);
                const targetUrl = log.target_url || (log.raw_response && log.raw_response.target_url);
                const multiSteps = log.multi_step_plan || (log.raw_response && log.raw_response.multi_step_plan);
                const outputText = log.output || (log.execution_result && (log.execution_result.output || log.execution_result.stdout || log.execution_result.stderr)) || "";
                const execResult = log.execution_result || {};
                const discussions = log.multi_agent_discussion || (log.raw_response && log.raw_response.multi_agent_discussion) || [];

                return `
                    <tr class="hover:bg-slate-900/60 transition cursor-pointer" onclick="toggleLogDetails(${log.id})">
                        <td class="p-4 whitespace-nowrap font-mono text-slate-400 text-[11px]">
                            <span class="text-indigo-400 font-bold">#${log.id}</span>
                            <span class="ml-1 text-slate-500">${dateStr}</span>
                        </td>
                        <td class="p-4 max-w-[280px]">
                            <div class="truncate text-slate-200 font-semibold text-xs" title="${esc(log.prompt)}">${esc(log.prompt)}</div>
                            <div class="text-[10px] text-slate-500 font-mono mt-0.5">${esc(log.os_context || 'Linux')}</div>
                        </td>
                        <td class="p-4 whitespace-nowrap">
                            <span class="px-2.5 py-1 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 font-mono text-[10px] uppercase font-semibold">
                                ${esc(capType.replace(/_/g, ' '))}
                            </span>
                        </td>
                        <td class="p-4 whitespace-nowrap font-mono text-slate-300 text-[11px]">
                            ${esc(model.split('/').pop() || model)}
                        </td>
                        <td class="p-4 whitespace-nowrap font-mono text-cyan-400 text-[11px]">
                            ${latency}
                        </td>
                        <td class="p-4 whitespace-nowrap">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase font-mono ${isSafe ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/10 text-rose-400 border border-rose-500/30'}">
                                ${isSafe ? '✓ Safe' : '🛑 Blocked'}
                            </span>
                        </td>
                        <td class="p-4 whitespace-nowrap text-right" onclick="event.stopPropagation()">
                            <button id="toggle-btn-${log.id}" onclick="toggleLogDetails(${log.id})" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 text-xs font-semibold transition flex items-center gap-1 ml-auto">
                                ${isExpanded ? '▲ Close' : '▼ Inspect'}
                            </button>
                        </td>
                    </tr>

                    <!-- Expanded Detail & Output Card -->
                    <tr id="detail-row-${log.id}" class="${isExpanded ? '' : 'hidden'} bg-slate-950/90 border-b border-indigo-500/20">
                        <td colspan="7" class="p-6">
                            <div class="space-y-4 max-w-6xl mx-auto">
                                
                                <!-- Top Row: Prompt & OS Metadata -->
                                <div class="bg-slate-900/90 rounded-2xl p-4 border border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-3">
                                    <div class="flex-1">
                                        <div class="text-[10px] text-slate-500 uppercase font-mono tracking-wider">Full Prompt Request</div>
                                        <div class="text-sm font-semibold text-white mt-0.5">${esc(log.prompt)}</div>
                                    </div>
                                    <div class="flex items-center gap-2 shrink-0">
                                        <button id="copy-p-${log.id}" onclick="copyToClipboard('${esc(log.prompt).replace(/'/g, "\\'")}', 'copy-p-${log.id}')" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-mono border border-slate-700">Copy Prompt</button>
                                        <a href="/?prompt=${encodeURIComponent(log.prompt)}" class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold">Load in Command Center</a>
                                    </div>
                                </div>

                                <!-- Direct Contextual Answer (if available) -->
                                ${directAnswer ? `
                                    <div class="bg-gradient-to-br from-indigo-950/40 to-slate-900 rounded-2xl p-4 border border-indigo-500/30">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="text-xs font-bold text-indigo-300 flex items-center gap-1.5">
                                                <span>💡</span> Contextual Answer & Insights
                                            </div>
                                            <button id="copy-a-${log.id}" onclick="copyToClipboard('${esc(directAnswer).replace(/'/g, "\\'")}', 'copy-a-${log.id}')" class="text-[11px] text-indigo-400 hover:text-indigo-300 font-mono">Copy Answer</button>
                                        </div>
                                        <div class="text-xs text-slate-200 leading-relaxed whitespace-pre-wrap font-sans bg-slate-950/60 p-3.5 rounded-xl border border-slate-800">${esc(directAnswer)}</div>
                                    </div>
                                ` : ''}

                                <!-- Generated Command / Script / Web URL -->
                                ${shellScript ? `
                                    <div class="bg-slate-900/90 rounded-2xl p-4 border border-slate-800">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="text-xs font-bold text-emerald-400 font-mono flex items-center gap-1.5">
                                                <span>💻</span> Generated Host Command Payload
                                            </div>
                                            <button id="copy-s-${log.id}" onclick="copyToClipboard('${esc(shellScript).replace(/'/g, "\\'")}', 'copy-s-${log.id}')" class="text-[11px] text-emerald-400 hover:text-emerald-300 font-mono">Copy Script</button>
                                        </div>
                                        <pre class="bg-black/90 p-3.5 rounded-xl border border-slate-800 font-mono text-xs text-emerald-400 overflow-x-auto whitespace-pre-wrap">${esc(shellScript)}</pre>
                                    </div>
                                ` : ''}

                                ${targetUrl ? `
                                    <div class="bg-slate-900/90 rounded-2xl p-4 border border-slate-800 flex items-center justify-between">
                                        <div>
                                            <div class="text-[10px] text-slate-500 uppercase font-mono">Browser Target URL</div>
                                            <a href="${esc(targetUrl)}" target="_blank" class="text-xs font-mono text-cyan-400 hover:underline break-all mt-0.5 block">${esc(targetUrl)}</a>
                                        </div>
                                        <a href="${esc(targetUrl)}" target="_blank" class="px-3.5 py-1.5 rounded-xl bg-cyan-600/20 text-cyan-300 border border-cyan-500/30 text-xs font-bold shrink-0">Open Link ↗</a>
                                    </div>
                                ` : ''}

                                <!-- Multi-Step Plan (if multi-step) -->
                                ${multiSteps && Array.isArray(multiSteps) && multiSteps.length > 0 ? `
                                    <div class="bg-slate-900/90 rounded-2xl p-4 border border-slate-800">
                                        <div class="text-xs font-bold text-sky-400 font-mono mb-2 flex items-center gap-1.5">
                                            <span>📋</span> Multi-Step Workflow Pipeline (${multiSteps.length} Steps)
                                        </div>
                                        <div class="space-y-2">
                                            ${multiSteps.map((s, idx) => `
                                                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800/80 flex flex-col md:flex-row md:items-center justify-between gap-2">
                                                    <div class="flex items-center gap-2">
                                                        <span class="w-5 h-5 rounded bg-indigo-900/50 text-indigo-300 text-[10px] font-bold flex items-center justify-center font-mono">${s.step_id || idx+1}</span>
                                                        <span class="text-xs font-medium text-slate-200">${esc(s.name || s.description || 'Step')}</span>
                                                    </div>
                                                    <div class="font-mono text-xs text-emerald-400 bg-black/60 px-3 py-1 rounded-lg border border-slate-900 truncate max-w-md">${esc(s.command || s.script || '—')}</div>
                                                </div>
                                            `).join('')}
                                        </div>
                                    </div>
                                ` : ''}

                                <!-- Live Execution Terminal Output -->
                                ${outputText || (execResult && Object.keys(execResult).length > 0) ? `
                                    <div class="bg-slate-900/90 rounded-2xl p-4 border border-slate-800">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="text-xs font-bold text-cyan-300 font-mono flex items-center gap-1.5">
                                                <span>⚡</span> Host Execution Output & Telemetry
                                            </div>
                                            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold">
                                                ${execResult.exit_code === 0 ? 'Exit Code 0 (Success)' : (execResult.status || 'Verified')}
                                            </span>
                                        </div>
                                        <pre class="bg-black text-emerald-300 font-mono text-xs p-4 rounded-xl border border-emerald-950 max-h-60 overflow-y-auto whitespace-pre-wrap shadow-inner">${esc(outputText || JSON.stringify(execResult, null, 2))}</pre>
                                    </div>
                                ` : `
                                    <div class="bg-slate-900/40 rounded-xl p-3 border border-slate-800/60 text-slate-500 text-xs italic flex items-center gap-2">
                                        <span>ℹ️</span> No terminal output was produced (read-only informational or browser launch).
                                    </div>
                                `}

                                <!-- Multi-Agent Swarm Thoughts -->
                                ${discussions && discussions.length > 0 ? `
                                    <details class="bg-slate-900/60 rounded-xl p-3 border border-slate-800 text-xs cursor-pointer group">
                                        <summary class="font-semibold text-slate-400 group-hover:text-slate-200 transition">🤖 View Multi-Agent Syndicate Discussion (${discussions.length} Agents)</summary>
                                        <div class="mt-3 space-y-2 pt-2 border-t border-slate-800/80">
                                            ${discussions.map(d => `
                                                <div class="bg-slate-950/80 p-2.5 rounded-lg border border-slate-800">
                                                    <div class="font-bold text-indigo-300 font-mono text-[11px]">${esc(d.agent_name)}</div>
                                                    <div class="text-slate-300 text-xs mt-0.5">${esc(d.thought)}</div>
                                                </div>
                                            `).join('')}
                                        </div>
                                    </details>
                                ` : ''}

                                <!-- Raw JSON Inspector -->
                                <details class="bg-slate-900/40 rounded-xl p-3 border border-slate-800/60 text-xs cursor-pointer">
                                    <summary class="font-mono text-slate-500 hover:text-slate-400">View Raw Diagnostics JSON</summary>
                                    <pre class="mt-2 bg-slate-950 p-3 rounded-lg border border-slate-900 font-mono text-[11px] text-slate-400 overflow-x-auto max-h-48">${esc(JSON.stringify(log, null, 2))}</pre>
                                </details>

                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Attach filter listeners
        ['filter-time', 'filter-provider', 'filter-model', 'filter-search'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.addEventListener('input', renderAll);
        });

        loadAnalytics();
        setInterval(loadAnalytics, 5000);
    </script>
</body>
</html>