<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>{{title}} — OmniShell Analytics</title><script src="https://cdn.tailwindcss.com"></script><script src="https://cdn.jsdelivr.net/npm/chart.js"></script></head><body class="min-h-screen bg-slate-950 text-white p-5 sm:p-8"><main class="max-w-7xl mx-auto"><header class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7"><div><div class="text-[10px] uppercase tracking-[.25em] text-indigo-400">OmniShell / Telemetry</div><h1 class="text-3xl sm:text-4xl font-black mt-1">Reliability & Model Analytics</h1><p class="text-slate-400 mt-2">Observe model usage, failures, fallback behavior and execution reliability.</p></div><nav class="flex gap-2"><a href="/" class="px-4 py-2 rounded-xl bg-indigo-600 text-sm font-bold">Command Center</a><a href="/pipeline" class="px-4 py-2 rounded-xl bg-slate-800 text-sm">Pipeline</a></nav></header><section class="grid grid-cols-2 lg:grid-cols-6 gap-3 mb-5"><div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Requests</div><div id="exec" class="text-2xl font-black mt-1">0</div></div><div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Tokens</div><div id="tokens" class="text-2xl font-black text-violet-300 mt-1">0</div></div><div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Success</div><div id="success" class="text-2xl font-black text-emerald-300 mt-1">0%</div></div><div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Failures</div><div id="failure" class="text-2xl font-black text-red-300 mt-1">0%</div></div><div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Recovered</div><div id="recovered" class="text-2xl font-black text-cyan-300 mt-1">0</div></div><div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Fallbacks</div><div id="fallbacks" class="text-2xl font-black text-amber-300 mt-1">0</div></div></section><section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-5 flex flex-wrap gap-3"><select id="time" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm"><option value="all">All time</option><option value="today">Today</option><option value="week">7 days</option><option value="month">30 days</option></select><select id="provider" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm"><option value="all">All providers</option></select><select id="model" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-sm"><option value="all">All models</option></select></section><section class="grid lg:grid-cols-2 gap-5"><div class="bg-slate-900 border border-slate-800 rounded-3xl p-5"><h2 class="font-bold mb-4">Token / Request Volume</h2><canvas id="usage"></canvas></div><div class="bg-slate-900 border border-slate-800 rounded-3xl p-5"><h2 class="font-bold mb-4">Success / Failure</h2><canvas id="successChart"></canvas></div></section><section class="grid lg:grid-cols-2 gap-5 mt-5"><div class="bg-slate-900 border border-slate-800 rounded-3xl p-5"><h2 class="font-bold mb-3">Fallback Chain</h2><div id="flow" class="flex flex-wrap gap-2"></div></div><div class="bg-slate-900 border border-slate-800 rounded-3xl p-5"><h2 class="font-bold mb-3">Failure Categories</h2><div id="failures" class="space-y-2"></div></div></section></main><script>
let raw=[],flow=[],uChart,pChart;const one=86400;async function load(){const r=await fetch('http://localhost:8000/api/analytics');const j=await r.json();raw=j.data||[];flow=j.fallback_flow||[];fill();render()}function fill(){const ps=[...new Set(raw.map(x=>x.provider).filter(Boolean))],ms=[...new Set(raw.map(x=>x.model).filter(Boolean))];for(const [id,arr] of [['provider',ps],['model',ms]]){const el=document.getElementById(id);for(const x of arr){const o=document.createElement('option');o.value=x;o.textContent=x;el.appendChild(o)}}document.getElementById('flow').innerHTML=flow.map((x,i)=>`<span class="px-3 py-1.5 rounded-xl bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-mono">${i+1}. ${x}</span>`).join('')||'<span class="text-slate-500 text-sm">No fallback models configured</span>'}function data(){const t=document.getElementById('time').value,p=document.getElementById('provider').value,m=document.getElementById('model').value,now=Date.now()/1000;return raw.filter(x=>(p==='all'||x.provider===p)&&(m==='all'||x.model===m)&& (t==='all'||now-x.timestamp<({today:one,week:one*7,month:one*30}[t]||Infinity)))}function render(){const d=data(),ok=d.filter(x=>x.success).length,bad=d.length-ok,tok=d.reduce((a,x)=>a+(x.total_tokens||0),0);document.getElementById('exec').textContent=d.length;document.getElementById('tokens').textContent=tok.toLocaleString();document.getElementById('success').textContent=(d.length?Math.round(ok/d.length*100):0)+'%';document.getElementById('failure').textContent=(d.length?Math.round(bad/d.length*100):0)+'%';document.getElementById('recovered').textContent=d.filter(x=>x.recovered||x.recovery).length;document.getElementById('fallbacks').textContent=d.filter(x=>x.fallback_used||x.fallback).length;const g={};d.forEach(x=>{const k=new Date(x.timestamp*1000).toLocaleDateString();g[k]=(g[k]||0)+(x.total_tokens||0)});if(uChart)uChart.destroy();uChart=new Chart(document.getElementById('usage'),{type:'line',data:{labels:Object.keys(g),datasets:[{label:'Tokens',data:Object.values(g),borderColor:'#818cf8',backgroundColor:'rgba(129,140,248,.12)',fill:true,tension:.35}]},options:{responsive:true}});if(pChart)pChart.destroy();pChart=new Chart(document.getElementById('successChart'),{type:'doughnut',data:{labels:['Success','Failure'],datasets:[{data:[ok,bad],backgroundColor:['#34d399','#f87171'],borderWidth:0}]},options:{cutout:'70%',responsive:true}});const cats={};d.filter(x=>!x.success).forEach(x=>{const c=x.error_category||x.failure_category||x.error||'unknown';cats[c]=(cats[c]||0)+1});document.getElementById('failures').innerHTML=Object.entries(cats).sort((a,b)=>b[1]-a[1]).slice(0,8).map(([k,v])=>`<div class="flex justify-between bg-slate-950 rounded-xl p-3 border border-slate-800 text-xs"><span class="text-slate-300">${k}</span><span class="text-red-300 font-bold">${v}</span></div>`).join('')||'<div class="text-slate-500 text-sm">No failures in the selected range.</div>'}['time','provider','model'].forEach(id=>document.getElementById(id).addEventListener('change',render));load();setInterval(load,10000);</script></body></html>