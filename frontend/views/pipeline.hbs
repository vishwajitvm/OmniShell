<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>{{title}} — OmniShell Control Plane</title><script src="https://cdn.tailwindcss.com"></script><style>body{background:radial-gradient(circle at top,#172554 0,#020617 45%,#020617 100%)}.glass{background:rgba(15,23,42,.78);backdrop-filter:blur(14px);border:1px solid rgba(148,163,184,.12)}</style></head><body class="min-h-screen text-white p-5 sm:p-8"><main class="max-w-7xl mx-auto"><header class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 mb-7"><div><div class="text-[10px] uppercase tracking-[.25em] text-indigo-400">OmniShell / Operations</div><h1 class="text-3xl sm:text-4xl font-black mt-1">Workflow Control Plane</h1><p class="text-slate-400 mt-2 max-w-3xl">Monitor scheduled, recurring, conditional, approval-gated and failed workflows from one operational view.</p></div><nav class="flex gap-2"><a href="/" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-sm font-bold">Command Center</a><a href="/analytics" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-sm">Analytics</a></nav></header><section class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-5"><div class="glass rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Total</div><div id="k-total" class="text-2xl font-black mt-1">0</div></div><div class="glass rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Running</div><div id="k-running" class="text-2xl font-black text-cyan-300 mt-1">0</div></div><div class="glass rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Approval</div><div id="k-approval" class="text-2xl font-black text-amber-300 mt-1">0</div></div><div class="glass rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Failed</div><div id="k-failed" class="text-2xl font-black text-red-300 mt-1">0</div></div><div class="glass rounded-2xl p-4"><div class="text-[10px] text-slate-500 uppercase">Recurring</div><div id="k-recurring" class="text-2xl font-black text-emerald-300 mt-1">0</div></div></section><section class="glass rounded-3xl p-4 mb-5"><div class="flex flex-col md:flex-row gap-3"><input id="search" class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm outline-none focus:border-indigo-500" placeholder="Search requests, capabilities, IDs…"><select id="status" class="bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm"><option value="all">All states</option><option>scheduled</option><option>awaiting_approval</option><option>approved</option><option>completed</option><option>failed</option><option>denied</option><option>cancelled</option><option>expired</option></select><label class="flex items-center gap-2 px-3 text-xs text-slate-400"><input id="recurring" type="checkbox"> recurring only</label></div></section><section class="glass rounded-3xl overflow-hidden"><div class="px-5 py-4 border-b border-slate-800 flex justify-between"><div><h2 class="font-bold">Workflow Registry</h2><p class="text-xs text-slate-500 mt-1">Live state, schedule, capability and recovery visibility.</p></div><span id="refresh-state" class="text-[10px] text-slate-500">live</span></div><div class="overflow-x-auto"><table class="w-full text-left"><thead class="bg-slate-950/70 text-[10px] uppercase tracking-wider text-slate-500"><tr><th class="p-4">Workflow</th><th class="p-4">Intent</th><th class="p-4">Schedule</th><th class="p-4">State</th><th class="p-4">Attempts</th><th class="p-4">Action</th></tr></thead><tbody id="body"></tbody></table></div></section></main><script>
let tasks=[];const esc=x=>String(x??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function badge(s){const m={completed:'emerald',failed:'red',awaiting_approval:'amber',approved:'indigo',scheduled:'cyan',denied:'red',cancelled:'slate',expired:'orange'};const c=m[s]||'slate';return `<span class="px-2 py-1 rounded-full bg-${c}-500/10 border border-${c}-500/30 text-${c}-300 text-[10px] font-bold uppercase">${esc(s||'unknown')}</span>`}
function render(){const q=document.getElementById('search').value.toLowerCase(), st=document.getElementById('status').value, rr=document.getElementById('recurring').checked;const f=tasks.filter(t=>(st==='all'||t.status===st)&&(!rr||t.is_recurring)&&(`${t.id} ${t.original_prompt} ${t.capability_type}`.toLowerCase().includes(q)));document.getElementById('k-total').innerText=tasks.length;document.getElementById('k-running').innerText=tasks.filter(t=>['approved','running','triggered'].includes(t.status)).length;document.getElementById('k-approval').innerText=tasks.filter(t=>t.status==='awaiting_approval').length;document.getElementById('k-failed').innerText=tasks.filter(t=>['failed','expired'].includes(t.status)).length;document.getElementById('k-recurring').innerText=tasks.filter(t=>t.is_recurring).length;document.getElementById('body').innerHTML=f.length?f.map(t=>`<tr class="border-t border-slate-800/70 hover:bg-slate-900/60"><td class="p-4 min-w-[300px]"><div class="text-xs text-slate-500 font-mono">#${t.id}</div><div class="font-semibold text-sm mt-1">${esc(t.original_prompt)}</div></td><td class="p-4"><span class="text-[10px] text-indigo-300 bg-indigo-500/10 border border-indigo-500/20 rounded px-2 py-1 font-mono">${esc(t.capability_type||'workflow')}</span></td><td class="p-4 text-xs text-slate-400"><div>${t.scheduled_for?new Date(t.scheduled_for).toLocaleString():'—'}</div><div class="text-emerald-400 mt-1">${t.is_recurring?'↻ '+esc(t.recurrence_rule||'recurring'):'one-time'}</div></td><td class="p-4">${badge(t.status)}</td><td class="p-4 text-xs font-mono text-slate-400">${t.attempt_count??0} / ${t.max_attempts??3}</td><td class="p-4">${['scheduled','awaiting_approval','approved'].includes(t.status)?`<button onclick="cancelTask(${t.id})" class="px-3 py-1.5 rounded-lg bg-red-500/10 border border-red-500/30 text-red-300 text-xs hover:bg-red-500/20">Cancel</button>`:'<span class="text-slate-600">—</span>'}</td></tr>`).join(''):'<tr><td colspan="6" class="p-12 text-center text-slate-500">No workflows match the current filters.</td></tr>'}
async function load(){try{const r=await fetch('http://localhost:8000/api/scheduled-tasks');if(!r.ok)throw Error('backend unavailable');tasks=await r.json();render();document.getElementById('refresh-state').innerText='updated '+new Date().toLocaleTimeString()}catch(e){document.getElementById('refresh-state').innerText='offline'}}async function cancelTask(id){if(!confirm(`Cancel workflow #${id}?`))return;await fetch(`http://localhost:8000/api/scheduled-tasks/${id}/cancel`,{method:'POST'});load()}['search','status','recurring'].forEach(id=>document.getElementById(id).addEventListener('input',render));load();setInterval(load,3000);</script></body></html>