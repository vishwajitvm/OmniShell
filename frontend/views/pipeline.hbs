<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .glass {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 text-white font-sans p-8">
    
    <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-indigo-400">Scheduled Execution Control Center</h1>
            <a href="/" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded font-bold transition">← Back to Agent</a>
        </div>

        <div class="glass p-8 rounded-2xl shadow-2xl">
            <h2 class="text-xl font-semibold mb-4 text-slate-300">Active & Past Scheduled Tasks</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-600/50">
                            <th class="py-3 px-4 text-blue-400 font-semibold">ID</th>
                            <th class="py-3 px-4 text-blue-400 font-semibold w-1/3">Original Prompt</th>
                            <th class="py-3 px-4 text-blue-400 font-semibold">Scheduled Time</th>
                            <th class="py-3 px-4 text-blue-400 font-semibold">Countdown</th>
                            <th class="py-3 px-4 text-blue-400 font-semibold">Status</th>
                            <th class="py-3 px-4 text-blue-400 font-semibold text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="pipeline-table-body">
                        <tr><td colspan="6" class="py-4 text-center text-slate-400 italic">Loading tasks...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function getStatusBadge(status) {
            switch(status) {
                case 'scheduled': return '<span class="px-2 py-1 bg-blue-500/20 text-blue-400 text-xs rounded-full border border-blue-500/30">SCHEDULED</span>';
                case 'awaiting_approval': return '<span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 text-xs rounded-full border border-yellow-500/30 animate-pulse">AWAITING APPROVAL</span>';
                case 'approved': return '<span class="px-2 py-1 bg-indigo-500/20 text-indigo-400 text-xs rounded-full border border-indigo-500/30">APPROVED</span>';
                case 'completed': return '<span class="px-2 py-1 bg-green-500/20 text-green-400 text-xs rounded-full border border-green-500/30">COMPLETED</span>';
                case 'failed': return '<span class="px-2 py-1 bg-red-500/20 text-red-400 text-xs rounded-full border border-red-500/30">FAILED</span>';
                case 'denied': return '<span class="px-2 py-1 bg-red-500/20 text-red-400 text-xs rounded-full border border-red-500/30">DENIED</span>';
                case 'cancelled': return '<span class="px-2 py-1 bg-gray-500/20 text-gray-400 text-xs rounded-full border border-gray-500/30">CANCELLED</span>';
                case 'expired': return '<span class="px-2 py-1 bg-orange-500/20 text-orange-400 text-xs rounded-full border border-orange-500/30">EXPIRED</span>';
                default: return `<span class="px-2 py-1 bg-gray-500/20 text-gray-400 text-xs rounded-full border border-gray-500/30">${status.toUpperCase()}</span>`;
            }
        }

        async function fetchPipeline() {
            try {
                const res = await fetch('http://localhost:8000/api/scheduled-tasks');
                if (!res.ok) throw new Error("Backend not responding");
                const tasks = await res.json();
                
                const tbody = document.getElementById('pipeline-table-body');
                tbody.innerHTML = '';
                
                if (tasks.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-slate-400 italic">No scheduled tasks found.</td></tr>';
                    return;
                }

                const now = new Date();

                tasks.forEach(t => {
                    const tr = document.createElement('tr');
                    tr.className = "border-b border-slate-700/30 hover:bg-slate-800/30 transition";
                    
                    const timeDate = new Date(t.scheduled_for);
                    
                    let countdownStr = "-";
                    if (['scheduled', 'awaiting_approval', 'approved'].includes(t.status)) {
                        const dist = timeDate.getTime() - now.getTime();
                        if (dist > 0) {
                            const h = Math.floor(dist / (1000 * 60 * 60));
                            const m = Math.floor((dist % (1000 * 60 * 60)) / (1000 * 60));
                            const s = Math.floor((dist % (1000 * 60)) / 1000);
                            countdownStr = `${h}h ${m}m ${s}s`;
                        } else {
                            countdownStr = "Due";
                        }
                    }

                    tr.innerHTML = `
                        <td class="py-3 px-4 font-mono text-xs text-slate-400">#${t.id}</td>
                        <td class="py-3 px-4 text-slate-200">
                            <div class="font-semibold text-indigo-200 text-sm truncate" style="max-width:300px;">"${t.original_prompt}"</div>
                            <div class="text-xs text-slate-400 mt-1">${t.requires_browser ? 'Web Browser' : 'Local Script'}</div>
                        </td>
                        <td class="py-3 px-4 text-sm text-blue-300">${timeDate.toLocaleString()}</td>
                        <td class="py-3 px-4 text-sm font-mono text-indigo-300">${countdownStr}</td>
                        <td class="py-3 px-4">
                            ${getStatusBadge(t.status)}
                        </td>
                        <td class="py-3 px-4 text-center">
                            ${t.status === 'scheduled' || t.status === 'awaiting_approval' 
                              ? `<button onclick="cancelTask(${t.id})" class="text-xs px-3 py-1 bg-red-600/20 hover:bg-red-500 border border-red-500/50 rounded text-red-200 hover:text-white font-bold transition">Cancel</button>`
                              : '-'
                            }
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

            } catch (err) {
                console.error(err);
            }
        }

        async function cancelTask(id) {
            if(!confirm(`Are you sure you want to cancel task #${id}?`)) return;
            try {
                await fetch(`http://localhost:8000/api/scheduled-tasks/${id}/cancel`, {method: 'POST'});
                fetchPipeline();
            } catch (err) {
                console.error("Failed to cancel task", err);
            }
        }

        fetchPipeline();
        setInterval(fetchPipeline, 1000);
    </script>
</body>
</html>
