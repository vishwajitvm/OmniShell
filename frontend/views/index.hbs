        let activePromptCategory = 'ALL';
        let promptSearchTerm = '';
        let isPromptLibraryInitialized = false;

        function showLibraryToast(msg) {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = "bg-slate-900/95 border border-indigo-500/50 text-indigo-200 px-4 py-2.5 rounded-xl text-xs font-semibold shadow-2xl flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0";
            toast.innerHTML = `<span>✨</span><span>${msg}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        function closePromptLibrary() {
            const drawer = document.getElementById('prompt-library-drawer');
            const chevron = document.getElementById('library-chevron');
            if (!drawer) return;
            if (!drawer.classList.contains('hidden')) {
                drawer.classList.add('hidden');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            }
        }

        function togglePromptLibrary() {
            const drawer = document.getElementById('prompt-library-drawer');
            const chevron = document.getElementById('library-chevron');
            if (!drawer) return;

            const isHidden = drawer.classList.contains('hidden');
            if (isHidden) {
                drawer.classList.remove('hidden');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                if (!isPromptLibraryInitialized) {
                    initPromptLibrary();
                    isPromptLibraryInitialized = true;
                }
                drawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                closePromptLibrary();
            }
        }

        function initPromptLibrary() {
            renderCategoryPills();
            renderPromptCards();
        }

        function renderCategoryPills() {
            const container = document.getElementById('prompt-category-pills');
            if (!container) return;

            const categories = ['ALL', ...new Set(PROMPT_LIBRARY.map(p => p.category))];
            
            container.innerHTML = categories.map(cat => {
                const count = cat === 'ALL' ? PROMPT_LIBRARY.length : PROMPT_LIBRARY.filter(p => p.category === cat).length;
                const isActive = activePromptCategory === cat;
                const activeClass = isActive 
                    ? 'bg-indigo-600 text-white font-bold border-indigo-400 shadow-md shadow-indigo-600/30' 
                    : 'bg-slate-800/80 hover:bg-slate-700/80 text-slate-300 border-slate-700/70 hover:border-indigo-500/40';
                
                const label = cat === 'ALL' ? '🌟 All Presets' : cat;
                return `
                    <button onclick="filterPromptCategory('${cat}')" class="px-3 py-1.5 rounded-xl border transition-all text-xs flex items-center gap-1.5 cursor-pointer ${activeClass}">
                        <span>${label}</span>
                        <span class="px-1.5 py-0.2 bg-black/25 rounded-md text-[10px] font-mono opacity-80">${count}</span>
                    </button>
                `;
            }).join('');
        }

        function filterPromptCategory(category) {
            activePromptCategory = category;
            renderCategoryPills();
            renderPromptCards();
        }

        function filterPromptLibrary() {
            const input = document.getElementById('prompt-search-input');
            const clearBtn = document.getElementById('clear-search-btn');
            promptSearchTerm = (input ? input.value : '').toLowerCase().trim();
            if (clearBtn) {
                if (promptSearchTerm) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }
            renderPromptCards();
        }

        function clearPromptSearch() {
            const input = document.getElementById('prompt-search-input');
            if (input) input.value = '';
            filterPromptLibrary();
        }

        function populatePrompt(text, autoRun = false) {
            const input = document.getElementById('prompt-input');
            if (!input) return;
            input.value = text;
            input.focus();
            
            // Auto collapse prompt library drawer on click / run
            closePromptLibrary();

            // Highlight input with a subtle pulse glow
            input.parentElement.classList.add('ring-2', 'ring-indigo-500');
            setTimeout(() => {
                input.parentElement.classList.remove('ring-2', 'ring-indigo-500');
            }, 1200);

            // Smooth scroll to input
            input.scrollIntoView({ behavior: 'smooth', block: 'center' });

            if (autoRun) {
                showLibraryToast(`⚡ Executing prompt: "${text.substring(0, 32)}..."`);
                const generateBtn = document.getElementById('generate-btn');
                if (generateBtn) setTimeout(() => generateBtn.click(), 150);
            } else {
                showLibraryToast(`✏️ Loaded into input. Edit parameters or press Enter to run!`);
            }
        }

        function copyPromptText(text, btnElement) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(() => {
                    showLibraryToast(`📋 Copied to clipboard!`);
                    if (btnElement) {
                        const origText = btnElement.innerHTML;
                        btnElement.innerHTML = `✅ Copied`;
                        setTimeout(() => { btnElement.innerHTML = origText; }, 1800);
                    }
                }).catch(() => {
                    setQuickPrompt(text);
                });
            } else {
                setQuickPrompt(text);
            }
        }

        function renderPromptCards() {
            const grid = document.getElementById('prompt-cards-grid');
            const counterText = document.getElementById('prompt-counter-text');
            if (!grid) return;

            let filtered = PROMPT_LIBRARY;
            if (activePromptCategory !== 'ALL') {
                filtered = filtered.filter(p => p.category === activePromptCategory);
            }
            if (promptSearchTerm) {
                filtered = filtered.filter(p => 
                    p.text.toLowerCase().includes(promptSearchTerm) || 
                    p.category.toLowerCase().includes(promptSearchTerm)
                );
            }

            if (counterText) {
                counterText.innerText = `Showing ${filtered.length} of ${PROMPT_LIBRARY.length} prompts`;
            }

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-500">
                        <div class="text-2xl mb-2">🔍</div>
                        <div class="text-sm font-semibold text-slate-400">No matching prompts found</div>
                        <div class="text-xs text-slate-500 mt-1">Try another search keyword or clear filters</div>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map((p, idx) => {
                const escapedText = escHtml(p.text);
                const jsEscaped = p.text.replace(/'/g, "\\'").replace(/"/g, '&quot;');
                return `
                    <div class="group relative bg-slate-950/80 hover:bg-slate-900 border border-slate-800 hover:border-indigo-500/50 rounded-2xl p-3.5 transition-all duration-200 flex flex-col justify-between shadow-lg hover:shadow-indigo-500/10 hover:-translate-y-0.5">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${p.badgeClass} flex items-center gap-1">
                                    <span>${p.icon}</span> <span>${p.category}</span>
                                </span>
                                <button onclick="copyPromptText('${jsEscaped}', this)" title="Copy prompt to clipboard" class="text-[10px] text-slate-500 hover:text-slate-300 px-1.5 py-0.5 rounded hover:bg-slate-800 transition">
                                    📋 Copy
                                </button>
                            </div>
                            <p class="text-xs text-slate-200 font-medium leading-snug cursor-pointer hover:text-indigo-300 transition" onclick="populatePrompt('${jsEscaped}', false)">
                                "${escapedText}"
                            </p>
                        </div>
                        <div class="flex items-center gap-2 mt-3 pt-2.5 border-t border-slate-800/80 text-[11px]">
                            <button onclick="populatePrompt('${jsEscaped}', false)" class="flex-1 py-1 px-2 bg-slate-800/90 hover:bg-indigo-600/30 text-slate-300 hover:text-indigo-200 rounded-lg border border-slate-700/70 hover:border-indigo-500/40 font-semibold transition text-center flex items-center justify-center gap-1">
                                <span>✏️</span> <span>Insert & Edit</span>
                            </button>
                            <button onclick="populatePrompt('${jsEscaped}', true)" class="py-1 px-3 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white rounded-lg font-bold shadow-md shadow-indigo-600/20 transition flex items-center justify-center gap-1">
                                <span>⚡</span> <span>Run</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        const CAPABILITY_ICONS = {
            question_answering: '💬 Question & Answer',
            information_request: 'ℹ️ Information Request',
            system_inspection: '🔍 System Inspection',
            analysis: '📊 Deep Analysis',
            application_operation: '💻 Application Operation',
            browser_operation: '🌐 Browser Operation',
            file_operation: '📁 File Operation',
            shell_operation: '⚡ Shell Command',
            multi_step: '📋 Multi-Step Workflow',
            interactive_workflow: '🤝 Interactive Workflow',
            scheduled_workflow: '⏰ Scheduled Workflow',
            recurring_workflow: '🔁 Recurring Workflow',
            conditional_workflow: '🔀 Conditional Workflow',
            reminder: '🔔 Desktop Reminder',
            research_task: '🔬 Research Task',
            planning_only: '📝 Planning Only',
            requires_human_approval: '🛡️ Human Approval Required',
            requires_clarification: '❓ Clarification Required',
            recovery_after_failure: '🔄 Failure Recovery'
        };

        function escHtml(str) {
            return String(str ?? '').replace(/[&<>"']/g, c => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[c]));
        }

        function toggleScheduledDropdown(e) {
            if (e) e.stopPropagation();
            const dd = document.getElementById('scheduled-dropdown');
            const chevron = document.getElementById('scheduled-chevron');
            if (dd) {
                const isHidden = dd.classList.contains('hidden');
                if (isHidden) {
                    dd.classList.remove('hidden');
                    if (chevron) chevron.style.transform = 'rotate(180deg)';
                } else {
                    dd.classList.add('hidden');
                    if (chevron) chevron.style.transform = 'rotate(0deg)';
                }
            }
        }

        document.addEventListener('click', (e) => {
            const container = document.getElementById('scheduled-widget-container');
            const dd = document.getElementById('scheduled-dropdown');
            const chevron = document.getElementById('scheduled-chevron');
            if (container && dd && !container.contains(e.target)) {
                dd.classList.add('hidden');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            }
        });

        async function fetchScheduledWidget() {
            try {
                const res = await fetch('http://localhost:8000/api/scheduled-tasks');
                if (!res.ok) return;
                const tasks = await res.json();
                const list = document.getElementById('scheduled-tasks-list');
                const badge = document.getElementById('scheduled-badge');
                const pulse = document.getElementById('scheduled-pulse');
                
                if (badge) badge.innerText = tasks.length;
                const hasRunning = tasks.some(t => ['executing', 'running', 'approved', 'triggered'].includes(t.status));
                if (pulse) {
                    if (hasRunning) pulse.classList.remove('hidden');
                    else pulse.classList.add('hidden');
                }

                if (!list) return;
                if (tasks.length === 0) {
                    list.innerHTML = '<li class="text-slate-500 text-xs italic py-4 text-center">No active scheduled tasks</li>';
                    return;
                }

                const badgeStyle = (st) => {
                    const m = {
                        completed: 'text-emerald-300 bg-emerald-500/10 border-emerald-500/30',
                        failed: 'text-red-300 bg-red-500/10 border-red-500/30',
                        awaiting_approval: 'text-amber-300 bg-amber-500/10 border-amber-500/30',
                        approved: 'text-indigo-300 bg-indigo-500/10 border-indigo-500/30',
                        scheduled: 'text-cyan-300 bg-cyan-500/10 border-cyan-500/30',
                        executing: 'text-purple-300 bg-purple-500/10 border-purple-500/30 animate-pulse',
                        cancelled: 'text-slate-400 bg-slate-500/10 border-slate-500/30',
                        expired: 'text-orange-300 bg-orange-500/10 border-orange-500/30'
                    };
                    return m[st] || 'text-slate-300 bg-slate-500/10 border-slate-500/30';
                };

                list.innerHTML = tasks.slice(0, 6).map(t => `
                    <li class="bg-slate-900/90 p-2.5 rounded-xl border border-slate-800/80 flex items-center justify-between text-xs gap-2 hover:border-slate-700 transition">
                        <div class="flex-1 min-w-0">
                            <div class="truncate text-slate-200 font-medium" title="${escHtml(t.original_prompt)}">${escHtml(t.original_prompt)}</div>
                            <div class="text-[10px] text-slate-500 flex items-center gap-1.5 mt-0.5 font-mono">
                                <span>#${t.id}</span>
                                ${t.is_recurring ? '<span class="text-emerald-400 font-sans">↻ recurring</span>' : ''}
                                ${t.scheduled_for ? `<span>• ${new Date(t.scheduled_for).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>` : ''}
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            ${t.status === 'awaiting_approval' ? `
                                <a href="/scheduled-approval?taskId=${t.id}" target="_blank" class="px-2 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-300 hover:bg-amber-500/30 text-[10px] font-bold uppercase transition flex items-center gap-1">
                                    <span>⚡</span> Approve
                                </a>
                            ` : ''}
                            <span class="px-2 py-0.5 rounded-full border text-[10px] font-mono font-semibold uppercase shrink-0 ${badgeStyle(t.status)}">${escHtml(t.status)}</span>
                        </div>
                    </li>
                `).join('');
            } catch (e) {}
        }
        fetchScheduledWidget();
        setInterval(fetchScheduledWidget, 5000);

        // Copy Direct Answer handler
        document.getElementById('copy-answer-btn')?.addEventListener('click', () => {
            const rawText = document.getElementById('direct-answer-content')?.innerText || '';
            navigator.clipboard.writeText(rawText);
            const btn = document.getElementById('copy-answer-btn');
            btn.innerHTML = '<span>✅ Copied!</span>';
            setTimeout(() => {
                btn.innerHTML = `
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                    <span>Copy Answer</span>
                `;
            }, 2000);
        });

        const LIFECYCLE_STAGES = ['Intent', 'Policy', 'Plan', 'Execute', 'Verify'];
        function renderLifecycle(data, state='READY') {
            const panel = document.getElementById('request-control-plane'); 
            if (panel) panel.classList.remove('hidden');
            const rail = document.getElementById('lifecycle-rail');
            const cap = data.capability_type || data.intent || 'unknown';
            const status = (data.scheduled_status || data.status || state || 'ready').toLowerCase();
            const isBlocked = data.is_safe === false || status.includes('block') || status.includes('denied');
            const isClarify = Boolean(data.requires_clarification || status.includes('clarif'));
            const isApproval = Boolean(data.requires_approval || status.includes('approval') || status.includes('awaiting'));
            const isDone = status === 'completed' || status === 'approved' || status === 'executed' || status === 'success';

            // Active stage index (0: Intent, 1: Policy, 2: Plan, 3: Execute, 4: Verify)
            let activeIdx = 0;
            if (isDone) {
                activeIdx = 4;
            } else if (isBlocked) {
                activeIdx = 1; // Blocked at Policy gate
            } else if (isClarify || isApproval) {
                activeIdx = 2; // Paused at Plan / Approval gate
            } else if (data.shell_script || data.requires_browser) {
                activeIdx = 3; // Ready for Execution
            } else if (data.direct_answer) {
                activeIdx = 4; // Complete informational answer
            } else {
                activeIdx = 2;
            }

            rail.innerHTML = LIFECYCLE_STAGES.map((stage, i) => {
                const isCompleted = i < activeIdx || (i === 4 && isDone);
                const isCurrent = i === activeIdx && !isDone;
                
                if (isCompleted) {
                    return `
                    <div class="rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-950/40 to-slate-900/90 p-3 shadow-md shadow-emerald-950/30 transition-all duration-300 hover:scale-[1.02]">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-black uppercase tracking-wider text-emerald-300">✓ ${stage}</span>
                            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400"></span>
                        </div>
                        <div class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-400 mt-1.5 flex items-center gap-1 font-mono">COMPLETED</div>
                    </div>`;
                }
                
                if (isCurrent) {
                    if (isBlocked) {
                        return `
                        <div class="rounded-2xl border-2 border-red-500 bg-gradient-to-br from-red-950/60 to-slate-900 p-3 shadow-xl shadow-red-500/30 animate-pulse transition-all duration-300">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-black uppercase tracking-wider text-red-200">✕ ${stage}</span>
                                <span class="w-2 h-2 rounded-full bg-red-400"></span>
                            </div>
                            <div class="text-[10px] font-extrabold uppercase tracking-wider text-red-400 mt-1.5 flex items-center gap-1 font-mono">BLOCKED</div>
                        </div>`;
                    }
                    if (isClarify || isApproval) {
                        return `
                        <div class="rounded-2xl border-2 border-amber-500 bg-gradient-to-br from-amber-950/60 to-slate-900 p-3 shadow-xl shadow-amber-500/30 animate-pulse transition-all duration-300">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-black uppercase tracking-wider text-amber-200">⚡ ${stage}</span>
                                <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                            </div>
                            <div class="text-[10px] font-extrabold uppercase tracking-wider text-amber-300 mt-1.5 flex items-center gap-1 font-mono">${isApproval ? 'APPROVAL REQ' : 'CLARIFICATION'}</div>
                        </div>`;
                    }
                    return `
                    <div class="rounded-2xl border-2 border-indigo-500 bg-gradient-to-br from-indigo-950/70 via-purple-950/30 to-slate-900 p-3 shadow-xl shadow-indigo-500/30 animate-pulse ring-2 ring-indigo-500/40 transition-all duration-300 hover:scale-[1.02]">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-black uppercase tracking-wider text-indigo-200">● ${stage}</span>
                            <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
                        </div>
                        <div class="text-[10px] font-extrabold uppercase tracking-wider text-indigo-300 mt-1.5 flex items-center gap-1 font-mono">ACTIVE</div>
                    </div>`;
                }

                return `
                <div class="rounded-2xl border border-slate-800/80 bg-slate-950/90 p-3 opacity-60">
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">○ ${stage}</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
                    </div>
                    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600 mt-1.5 font-mono">PENDING</div>
                </div>`;
            }).join('');

            // Control Plane State Badge
            const reqBadge = document.getElementById('request-state');
            if (isBlocked) {
                reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-red-500/25 text-red-200 border-red-500/60 shadow-lg shadow-red-500/30 animate-pulse';
                reqBadge.innerHTML = '🛑 BLOCKED';
            } else if (isApproval) {
                reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-yellow-500/25 text-yellow-200 border-yellow-500/60 shadow-lg shadow-yellow-500/30 font-extrabold animate-pulse';
                reqBadge.innerHTML = '🔒 APPROVAL REQUIRED';
            } else if (isClarify) {
                reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-amber-500/25 text-amber-200 border-amber-500/60 shadow-lg shadow-amber-500/30 font-extrabold';
                reqBadge.innerHTML = '⚡ CLARIFICATION';
            } else if (isDone) {
                reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-emerald-500/25 text-emerald-200 border-emerald-500/60 shadow-lg shadow-emerald-500/30 font-extrabold';
                reqBadge.innerHTML = '✅ COMPLETED';
            } else if (data.is_scheduled) {
                reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-purple-500/25 text-purple-200 border-purple-500/60 shadow-lg shadow-purple-500/30 font-extrabold';
                reqBadge.innerHTML = '⏰ SCHEDULED';
            } else {
                reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-indigo-500/25 text-indigo-200 border-indigo-500/60 shadow-lg shadow-indigo-500/30 animate-pulse';
                reqBadge.innerHTML = '🚀 ACTIVE';
            }

            // Status Metrics
            document.getElementById('intent-value').innerText = cap.replace(/_/g, ' ');
            document.getElementById('intent-confidence').innerText = data.intent_confidence != null ? `${Math.round(Number(data.intent_confidence) * 100)}%` : (data.confidence != null ? `${Math.round(Number(data.confidence) * 100)}%` : '98%');
            
            const riskEl = document.getElementById('risk-value');
            if (isBlocked) {
                riskEl.className = 'text-xs font-extrabold text-red-400 mt-1 flex items-center gap-1';
                riskEl.innerHTML = '🛑 BLOCKED';
            } else if (isApproval) {
                riskEl.className = 'text-xs font-extrabold text-amber-400 mt-1 flex items-center gap-1';
                riskEl.innerHTML = '⚠️ ELEVATED';
            } else {
                riskEl.className = 'text-xs font-extrabold text-emerald-400 mt-1 flex items-center gap-1';
                riskEl.innerHTML = '✅ VERIFIED SAFE';
            }

            const execEl = document.getElementById('execution-mode');
            if (data.is_scheduled) {
                execEl.className = 'text-xs font-extrabold text-purple-300 mt-1 truncate';
                execEl.innerText = '⏰ SCHEDULED';
            } else if (data.is_planning_only) {
                execEl.className = 'text-xs font-extrabold text-blue-300 mt-1 truncate';
                execEl.innerText = '📝 PLAN ONLY';
            } else if (data.shell_script || data.requires_browser) {
                execEl.className = 'text-xs font-extrabold text-cyan-300 mt-1 truncate animate-pulse';
                execEl.innerText = '⚡ HOST EXECUTION';
            } else if (data.direct_answer) {
                execEl.className = 'text-xs font-extrabold text-indigo-300 mt-1 truncate';
                execEl.innerText = '💬 DIRECT ANSWER';
            } else {
                execEl.className = 'text-xs font-extrabold text-slate-400 mt-1 truncate';
                execEl.innerText = '🔒 NON-EXECUTING';
            }

            // Safety Gate Side Panel
            const safetyBadge = document.getElementById('safety-badge');
            const safetySummary = document.getElementById('safety-summary');
            const safetyDetail = document.getElementById('safety-detail');

            if (isBlocked) {
                safetyBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black border bg-red-500/20 text-red-300 border-red-500/40 animate-pulse';
                safetyBadge.innerText = '🛑 Blocked';
                safetySummary.innerText = 'Dangerous Action Blocked';
                safetyDetail.innerText = data.approval_reason || 'This request attempts potentially destructive system changes and was blocked by policy.';
            } else if (isApproval) {
                safetyBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black border bg-yellow-500/20 text-yellow-300 border-yellow-500/40 animate-pulse';
                safetyBadge.innerText = '🔒 Approval Needed';
                safetySummary.innerText = 'Human Authorization Required';
                safetyDetail.innerText = data.approval_reason || 'This workflow involves system mutation or scheduling. Please authorize to proceed.';
            } else if (isClarify) {
                safetyBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black border bg-amber-500/20 text-amber-300 border-amber-500/40 animate-pulse';
                safetyBadge.innerText = '⚠️ Action Needed';
                safetySummary.innerText = 'Clarification Required';
                safetyDetail.innerText = (data.clarification_questions && data.clarification_questions[0]) || 'Please choose your preferred target outcome below so OmniShell can proceed safely.';
            } else {
                safetyBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black border bg-emerald-500/20 text-emerald-300 border-emerald-500/40';
                safetyBadge.innerText = '✅ Passed';
                safetySummary.innerText = 'Policy Gate Passed';
                safetyDetail.innerText = data.recovery_strategy ? 'Self-healing recovery policy is active in case of execution failure.' : 'No dangerous commands detected. Safe for execution.';
            }
        }

        function updateLifecycle(stages, stateLabel, details = {}) {
            const rail = document.getElementById('lifecycle-rail');
            if (rail && stages) {
                rail.innerHTML = LIFECYCLE_STAGES.map(stage => {
                    const st = (stages[stage] || 'pending').toLowerCase();
                    if (st === 'completed') {
                        return `
                        <div class="rounded-2xl border border-emerald-500/40 bg-gradient-to-br from-emerald-950/40 to-slate-900/90 p-3 shadow-md shadow-emerald-950/30 transition-all duration-300 hover:scale-[1.02]">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-black uppercase tracking-wider text-emerald-300">✓ ${stage}</span>
                                <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400"></span>
                            </div>
                            <div class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-400 mt-1.5 flex items-center gap-1 font-mono">COMPLETED</div>
                        </div>`;
                    }
                    if (st === 'active') {
                        return `
                        <div class="rounded-2xl border-2 border-indigo-500 bg-gradient-to-br from-indigo-950/70 via-purple-950/30 to-slate-900 p-3 shadow-xl shadow-indigo-500/30 animate-pulse ring-2 ring-indigo-500/40 transition-all duration-300 hover:scale-[1.02]">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-black uppercase tracking-wider text-indigo-200">● ${stage}</span>
                                <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
                            </div>
                            <div class="text-[10px] font-extrabold uppercase tracking-wider text-indigo-300 mt-1.5 flex items-center gap-1 font-mono">ACTIVE</div>
                        </div>`;
                    }
                    if (st === 'approval req' || st === 'approval_req') {
                        return `
                        <div class="rounded-2xl border-2 border-amber-500 bg-gradient-to-br from-amber-950/60 to-slate-900 p-3 shadow-xl shadow-amber-500/30 animate-pulse transition-all duration-300">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-black uppercase tracking-wider text-amber-200">⚡ ${stage}</span>
                                <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                            </div>
                            <div class="text-[10px] font-extrabold uppercase tracking-wider text-amber-300 mt-1.5 flex items-center gap-1 font-mono">APPROVAL REQ</div>
                        </div>`;
                    }
                    if (st === 'blocked' || st === 'failed') {
                        return `
                        <div class="rounded-2xl border-2 border-red-500 bg-gradient-to-br from-red-950/60 to-slate-900 p-3 shadow-xl shadow-red-500/30 animate-pulse transition-all duration-300">
                            <div class="flex items-center justify-between">
                                <span class="text-[11px] font-black uppercase tracking-wider text-red-200">✕ ${stage}</span>
                                <span class="w-2 h-2 rounded-full bg-red-400"></span>
                            </div>
                            <div class="text-[10px] font-extrabold uppercase tracking-wider text-red-400 mt-1.5 flex items-center gap-1 font-mono">${st.toUpperCase()}</div>
                        </div>`;
                    }
                    return `
                    <div class="rounded-2xl border border-slate-800/80 bg-slate-950/90 p-3 opacity-60">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">○ ${stage}</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
                        </div>
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-600 mt-1.5 font-mono">PENDING</div>
                    </div>`;
                }).join('');
            }

            const reqBadge = document.getElementById('request-state');
            if (reqBadge) {
                if (stateLabel) {
                    reqBadge.innerHTML = stateLabel;
                    if (stateLabel.includes('COMPLETED') || stateLabel.includes('EXECUTED') || stateLabel.includes('SUCCESS') || stateLabel.includes('DONE')) {
                        reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-emerald-500/25 text-emerald-200 border-emerald-500/60 shadow-lg shadow-emerald-500/30 font-extrabold';
                    } else if (stateLabel.includes('BLOCKED') || stateLabel.includes('FAILED') || stateLabel.includes('CANCELLED')) {
                        reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-red-500/25 text-red-200 border-red-500/60 shadow-lg shadow-red-500/30 font-extrabold';
                    } else if (stateLabel.includes('APPROVAL')) {
                        reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-yellow-500/25 text-yellow-200 border-yellow-500/60 shadow-lg shadow-yellow-500/30 font-extrabold animate-pulse';
                    } else if (stateLabel.includes('ACTIVE') || stateLabel.includes('EXECUTING')) {
                        reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-indigo-500/25 text-indigo-200 border-indigo-500/60 shadow-lg shadow-indigo-500/30 animate-pulse';
                    }
                } else if (stages && stages.Verify === 'completed') {
                    reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-emerald-500/25 text-emerald-200 border-emerald-500/60 shadow-lg shadow-emerald-500/30 font-extrabold';
                    reqBadge.innerHTML = '✅ EXECUTED & VERIFIED';
                } else if (stages && stages.Execute === 'active') {
                    reqBadge.className = 'px-3.5 py-1.5 rounded-full text-xs font-black border uppercase tracking-wider bg-indigo-500/25 text-indigo-200 border-indigo-500/60 shadow-lg shadow-indigo-500/30 animate-pulse';
                    reqBadge.innerHTML = '🚀 EXECUTING';
                }
            }

            if (details.risk) {
                const riskEl = document.getElementById('risk-value');
                if (riskEl) {
                    riskEl.className = 'text-xs font-extrabold text-emerald-400 mt-1 flex items-center gap-1';
                    riskEl.innerHTML = details.risk;
                }
            }

            if (details.safetySummary || details.safetyDetail) {
                const sBadge = document.getElementById('safety-badge');
                const sSum = document.getElementById('safety-summary');
                const sDet = document.getElementById('safety-detail');
                if (sBadge) {
                    sBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-black border bg-emerald-500/20 text-emerald-300 border-emerald-500/40';
                    sBadge.innerText = '✅ Authorized';
                }
                if (sSum && details.safetySummary) sSum.innerText = details.safetySummary;
                if (sDet && details.safetyDetail) sDet.innerText = details.safetyDetail;
            }

            if (details.executionMode) {
                const execEl = document.getElementById('execution-mode');
                if (execEl) {
                    execEl.className = 'text-xs font-extrabold text-emerald-300 mt-1 truncate';
                    execEl.innerText = details.executionMode;
                }
            }
        }

        // Enter Key Listener on Input
        document.getElementById('prompt-input').addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                closePromptLibrary();
                document.getElementById('generate-btn').click();
            }
        });

        // Main Execution Trigger
        document.getElementById('generate-btn').addEventListener('click', async () => {
            closePromptLibrary();
            const prompt = document.getElementById('prompt-input').value;
            if (!prompt.trim()) return;
            
            // Clear old terminal outputs
            document.querySelectorAll('.terminal-output-box').forEach(el => el.remove());

            document.getElementById('btn-text').innerText = 'Agents Synthesizing...';
            document.getElementById('btn-spinner').classList.remove('hidden');
            document.getElementById('error-banner').classList.add('hidden');
            document.getElementById('results-section').classList.add('hidden');

            try {
                const osContext = navigator.userAgent;

                const res = await fetch('http://localhost:8000/api/generate-workflow', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        natural_language_prompt: prompt,
                        user_agent_os: osContext,
                        local_time: new Date().toISOString(),
                        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone
                    })
                });
                
                const data = await res.json();
                if (!res.ok) throw new Error(data.detail || 'API Error');
                renderLifecycle(data, 'READY');

                // Render Capability Badge
                const capKey = data.capability_type || 'question_answering';
                const capBadge = document.getElementById('capability-badge');
                capBadge.innerText = CAPABILITY_ICONS[capKey] || `⚡ ${capKey.replace(/_/g, ' ').toUpperCase()}`;
                
                // Security Status
                const statusDiv = document.getElementById('guardrail-status');
                if (data.is_safe) {
                    statusDiv.className = 'px-4 py-1.5 rounded-xl border bg-emerald-900/30 border-emerald-500/50 text-emerald-300';
                    statusDiv.innerHTML = `✅ OS: ${data.target_os} (Safe)`;
                } else {
                    statusDiv.className = 'px-4 py-1.5 rounded-xl border bg-red-900/30 border-red-500/50 text-red-300';
                    statusDiv.innerHTML = `🛑 BLOCKED: Malicious Intent`;
                }

                // Render Direct Answer Card
                const directAnswerCard = document.getElementById('direct-answer-card');
                const directAnswerContent = document.getElementById('direct-answer-content');
                if (data.direct_answer) {
                    if (window.marked) {
                        directAnswerContent.innerHTML = window.marked.parse(data.direct_answer);
                    } else {
                        directAnswerContent.innerText = data.direct_answer;
                    }
                    directAnswerCard.classList.remove('hidden');
                } else {
                    directAnswerCard.classList.add('hidden');
                }

                // Render Clarification Card
                const clarCard = document.getElementById('clarification-card');
                const clarOptions = document.getElementById('clarification-options');
                if (data.requires_clarification && data.clarification_questions && data.clarification_questions.length > 0) {
                    clarOptions.innerHTML = data.clarification_questions.map(q => `
                        <button onclick="submitClarification('${q.replace(/'/g, "\\'")}')" class="px-3.5 py-2 bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-200 text-xs rounded-xl transition text-left cursor-pointer">
                            👉 ${q}
                        </button>
                    `).join('');
                    clarCard.classList.remove('hidden');
                } else {
                    clarCard.classList.add('hidden');
                }

                // Render Multi-Step Plan
                const multiCard = document.getElementById('multistep-card');
                const multiItems = document.getElementById('multistep-items');
                const runMultiBtn = document.getElementById('run-multistep-btn');
                if (data.multi_step_plan && Array.isArray(data.multi_step_plan) && data.multi_step_plan.length > 0) {
                    multiItems.innerHTML = data.multi_step_plan.map((step, idx) => {
                        const stepNum = step.step_id || step.step || step.id || (idx + 1);
                        const stepTitle = step.name || step.title || step.action || step.description || `Step ${stepNum}`;
                        const stepDesc = (step.description && step.description !== stepTitle) ? step.description : '';
                        const stepCmd = step.command || step.script || step.cmd || '';
                        
                        let stepExpected = step.expected || step.expected_outcome || step.validation || step.verify || '';
                        if (typeof stepExpected === 'object' && stepExpected !== null) {
                            stepExpected = Object.entries(stepExpected).map(([k, v]) => `${k}: ${v}`).join(', ');
                        }

                        return `
                            <div class="bg-slate-950/90 p-4 rounded-2xl border border-slate-800/90 hover:border-sky-500/40 transition flex items-start gap-3.5 shadow-md">
                                <span class="w-7 h-7 rounded-xl bg-sky-500/20 text-sky-400 border border-sky-500/30 flex items-center justify-center text-xs font-bold shrink-0 font-mono">
                                    ${stepNum}
                                </span>
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-semibold text-slate-100 flex items-center justify-between">
                                        <span>${escHtml(stepTitle)}</span>
                                        <span class="text-[10px] font-mono text-sky-400 uppercase tracking-wider px-2 py-0.5 rounded bg-sky-500/10 border border-sky-500/20">Step ${stepNum}</span>
                                    </div>
                                    ${stepDesc ? `<div class="text-xs text-slate-400 mt-1 leading-relaxed">${escHtml(stepDesc)}</div>` : ''}
                                    ${stepCmd ? `<pre class="text-xs text-emerald-400 font-mono bg-slate-900/90 p-2.5 rounded-xl mt-2 overflow-x-auto border border-slate-800">${escHtml(stepCmd)}</pre>` : ''}
                                    ${stepExpected ? `<div class="text-[11px] text-cyan-300/90 mt-2 flex items-center gap-1.5 font-medium"><span class="text-xs">🎯</span> <span>Expected:</span> <span class="text-slate-300">${escHtml(stepExpected)}</span></div>` : ''}
                                </div>
                            </div>
                        `;
                    }).join('');
                    multiCard.classList.remove('hidden');
                    if (data.is_safe && !data.is_scheduled && !data.is_planning_only) {
                        runMultiBtn.classList.remove('hidden');
                        runMultiBtn.onclick = () => executeMultiStepPlan(data.multi_step_plan);
                    } else {
                        runMultiBtn.classList.add('hidden');
                    }
                } else {
                    multiCard.classList.add('hidden');
                }

                // Advanced Info (Recurrence & Recovery)
                const advCard = document.getElementById('advanced-info-card');
                const recBox = document.getElementById('recurrence-box');
                const recText = document.getElementById('recurrence-text');
                const recovBox = document.getElementById('recovery-box');
                const recovText = document.getElementById('recovery-text');
                
                let showAdv = false;
                if (data.is_recurring && data.recurrence_rule) {
                    recText.innerText = `Rule: ${data.recurrence_rule}`;
                    recBox.classList.remove('hidden');
                    showAdv = true;
                } else {
                    recBox.classList.add('hidden');
                }

                if (data.recovery_strategy) {
                    if (typeof data.recovery_strategy === 'object') {
                        const strat = data.recovery_strategy;
                        recovText.innerHTML = `
                            <div class="space-y-1 text-xs">
                                ${strat.retry_limit ? `<div><span class="text-slate-400">Retry Limit:</span> <span class="text-amber-300 font-bold">${strat.retry_limit} attempts</span></div>` : ''}
                                ${strat.diagnostic_command ? `<div><span class="text-slate-400">Diagnostic:</span> <code class="text-cyan-300">${escHtml(strat.diagnostic_command)}</code></div>` : ''}
                                ${strat.fallback_script ? `<div><span class="text-slate-400">Fallback:</span> <code class="text-emerald-300">${escHtml(strat.fallback_script)}</code></div>` : ''}
                            </div>
                        `;
                    } else {
                        recovText.innerText = data.recovery_strategy;
                    }
                    recovBox.classList.remove('hidden');
                    showAdv = true;
                } else {
                    recovBox.classList.add('hidden');
                }

                if (showAdv) advCard.classList.remove('hidden');
                else advCard.classList.add('hidden');

                // Render Discussion
                const discussionHtml = data.multi_agent_discussion.map(agent => `
                    <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                        <span class="text-indigo-400 font-bold text-xs uppercase tracking-wide">${agent.agent_name}</span>
                        <p class="text-slate-300 text-sm mt-1 leading-relaxed">${agent.thought}</p>
                    </div>
                `).join('');
                document.getElementById('discussion-container').innerHTML = discussionHtml;

                // Script Output visibility
                const scriptContainer = document.getElementById('script-output-container');
                const scriptOutput = document.getElementById('powershell-output');
                const scriptTypeLabel = document.getElementById('script-type-label');
                
                const isNonExec = ['question_answering', 'information_request', 'analysis', 'planning_only', 'requires_clarification'].includes(data.capability_type) && !data.shell_script;

                if (isNonExec) {
                    scriptContainer.classList.add('hidden');
                } else {
                    scriptContainer.classList.remove('hidden');
                    const copyBtn = document.getElementById('copy-script-btn');
                    const runBtn = document.getElementById('run-script-btn');
                    const manualTerm = document.getElementById('manual-terminal-output');
                    manualTerm.classList.add('hidden');
                    manualTerm.innerText = '';

                    if (copyBtn) {
                        copyBtn.onclick = () => {
                            navigator.clipboard.writeText(scriptOutput.innerText);
                            copyBtn.innerText = '✓ Copied!';
                            setTimeout(() => { copyBtn.innerText = '📋 Copy'; }, 2000);
                        };
                    }

                    if (data.requires_browser && data.target_url) {
                        scriptTypeLabel.innerText = "browser_url";
                        scriptOutput.innerText = "// Web Navigation Target:\n" + data.target_url;
                        if (runBtn) {
                            runBtn.innerText = '🌐 Launch URL';
                            runBtn.onclick = async () => {
                                runBtn.innerText = '⏳ Launching...';
                                try {
                                    const osIsLinux = (data.target_os || '').toLowerCase().includes('linux');
                                    const osIsMac = (data.target_os || '').toLowerCase().includes('darwin') || (data.target_os || '').toLowerCase().includes('mac');
                                    let script = data.shell_script 
                                        ? (osIsLinux ? `(${data.shell_script}) >/dev/null 2>&1 &` : data.shell_script) 
                                        : (osIsLinux ? `(brave-browser "${data.target_url}" || firefox "${data.target_url}" || xdg-open "${data.target_url}") >/dev/null 2>&1 &` : (osIsMac ? `open "${data.target_url}"` : `Start-Process "${data.target_url}"`));
                                    await fetch('http://localhost:8003/execute', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ script, approved: true })
                                    });
                                    runBtn.innerText = '✅ Launched!';
                                    updateLifecycle(
                                        { Intent: 'completed', Policy: 'completed', Plan: 'completed', Execute: 'completed', Verify: 'completed' },
                                        '✅ EXECUTED & VERIFIED',
                                        {
                                            risk: '✅ VERIFIED SAFE',
                                            safetySummary: 'Browser Launched',
                                            safetyDetail: 'Target URL opened on host successfully.',
                                            executionMode: '🌐 BROWSER OPERATION (LAUNCHED)'
                                        }
                                    );
                                } catch(e) {
                                    runBtn.innerText = '❌ Failed (Executor Offline)';
                                }
                            };
                        }
                    } else if (data.shell_script) {
                        scriptTypeLabel.innerText = data.target_os.toLowerCase().includes('linux') ? "bash" : "powershell";
                        scriptOutput.innerText = data.shell_script;
                        if (runBtn) {
                            runBtn.innerText = '⚡ Run on Host';
                            runBtn.onclick = async () => {
                                runBtn.innerText = '⏳ Executing...';
                                updateLifecycle({ Intent: 'completed', Policy: 'completed', Plan: 'completed', Execute: 'active', Verify: 'pending' });
                                try {
                                    const res = await fetch('http://localhost:8003/execute', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            script: data.shell_script,
                                            expected_process: data.expected_process,
                                            approved: true
                                        })
                                    });
                                    const resData = await res.json();
                                    const isSuccess = resData.success !== false;
                                    runBtn.innerText = isSuccess ? '✅ Done' : '❌ Failed';
                                    manualTerm.classList.remove('hidden');
                                    const termOut = resData.output || resData.stdout || resData.stderr || (isSuccess ? 'Executed with exit code 0' : 'Execution failed');
                                    manualTerm.innerText = `> ${data.shell_script}\n\n${termOut.trim()}`;
                                    updateLifecycle(
                                        {
                                            Intent: 'completed',
                                            Policy: 'completed',
                                            Plan: 'completed',
                                            Execute: isSuccess ? 'completed' : 'failed',
                                            Verify: isSuccess ? 'completed' : 'failed'
                                        },
                                        isSuccess ? '✅ EXECUTED & VERIFIED' : '❌ EXECUTION FAILED',
                                        {
                                            risk: isSuccess ? '✅ AUTHORIZED & EXECUTED' : '⚠️ FAILED',
                                            safetySummary: isSuccess ? 'Authorization Granted - Executed on Host' : 'Execution Failed',
                                            safetyDetail: isSuccess ? 'Host executor completed command with exit code 0.' : 'Command execution failed on host.',
                                            executionMode: '⚡ HOST EXECUTION (COMPLETED)'
                                        }
                                    );
                                } catch(e) {
                                    runBtn.innerText = '❌ Failed (Executor Offline)';
                                }
                            };
                        }
                    } else {
                        scriptContainer.classList.add('hidden');
                    }
                }

                document.getElementById('results-section').classList.remove('hidden');

                // Scheduled Notification & Separate Window Document Card Handling
                const schedApprovalCard = document.getElementById('scheduled-approval-card');
                const isScheduledTask = data.is_scheduled || data.scheduled_task_id;

                if (isScheduledTask) {
                    schedApprovalCard.classList.remove('hidden');
                    const taskId = data.scheduled_task_id || '';
                    const token = data.approval_token || 'admin';
                    
                    document.getElementById('scheduled-approval-id-badge').innerText = taskId ? `#${taskId}` : 'Queued';
                    document.getElementById('scheduled-approval-time').innerText = data.scheduled_time ? new Date(data.scheduled_time).toLocaleString() : 'Immediate';
                    document.getElementById('scheduled-approval-status').innerText = '🔒 POPUP WINDOW DOCUMENT';
                    document.getElementById('scheduled-approval-status').className = 'text-amber-300 font-mono font-bold mt-1';
                    document.getElementById('scheduled-approval-target').innerText = data.requires_browser ? 'Browser Navigation' : (data.shell_script ? 'Host Shell Script' : 'Multi-Step Workflow');
                    
                    document.getElementById('open-approval-doc-btn').onclick = () => {
                        const docUrl = `/scheduled-approval/${token}?taskId=${taskId}`;
                        window.open(docUrl, 'ScheduledApprovalDocument', 'width=750,height=850,scrollbars=yes,resizable=yes');
                    };
                } else {
                    schedApprovalCard.classList.add('hidden');
                }

                if (data.is_scheduled) {
                    statusDiv.innerHTML += ` <span class="ml-2 text-indigo-300">📅 Scheduled for ${new Date(data.scheduled_time).toLocaleString()}!</span>`;
                    fetchScheduledWidget();
                }

                // Timing
                if (data.timing) {
                    document.getElementById('timing-section').classList.remove('hidden');
                    const t = data.timing || {};
                    document.getElementById('time-llm').innerText = Number(t.llm_reasoning || 0).toFixed(2) + 's';
                    document.getElementById('time-res').innerText = Number(t.research || 0).toFixed(2) + 's';
                    document.getElementById('time-val').innerText = Number(t.validation || 0).toFixed(2) + 's';
                    document.getElementById('time-exe').innerText = Number(t.execution || 0).toFixed(2) + 's';
                    document.getElementById('time-tot').innerText = Number(t.total || 0).toFixed(2) + 's';
                }

                // Safe Native Host Execution (Only for executable tasks)
                const shouldPromptExecution = data.is_safe && !data.is_scheduled && !data.is_planning_only && (data.shell_script || (data.requires_browser && data.target_url)) && !['question_answering', 'information_request', 'requires_clarification'].includes(data.capability_type);

                if (shouldPromptExecution) {
                    const statusSpan = document.createElement('span');
                    statusSpan.className = "animate-pulse ml-2 text-yellow-300 text-xs";
                    statusSpan.innerText = "⚡ Awaiting Human Confirmation...";
                    statusDiv.appendChild(statusSpan);
                    
                    try {
                        if (data.requires_browser && data.target_url) {
                            const bRes = await fetch('http://localhost:8003/browsers').catch(() => null);
                            let browsers = ["Default Browser"];
                            if (bRes && bRes.ok) {
                                const bData = await bRes.json();
                                if (bData.browsers) browsers = bData.browsers;
                            }
                            
                            const inputOptions = {};
                            browsers.forEach(b => inputOptions[b] = b);
                            
                            const { value: selectedBrowser, isConfirmed } = await Swal.fire({
                                title: 'Open Browser Approval',
                                text: `Launch URL: ${data.target_url}?`,
                                input: 'select',
                                inputOptions: inputOptions,
                                inputPlaceholder: 'Select browser...',
                                showCancelButton: true,
                                confirmButtonText: 'Yes, Open!',
                                cancelButtonText: 'Cancel',
                                background: '#0f172a',
                                color: '#fff',
                                confirmButtonColor: '#10b981',
                                cancelButtonColor: '#ef4444',
                            });
                            
                            if (isConfirmed) {
                                statusSpan.innerText = `🚀 Launching ${selectedBrowser || 'Browser'}...`;
                                const osIsLinux = (data.target_os || '').toLowerCase().includes('linux');
                                const osIsMac = (data.target_os || '').toLowerCase().includes('darwin') || (data.target_os || '').toLowerCase().includes('mac');
                                let script = "";
                                
                                if (selectedBrowser === 'Brave') {
                                    script = osIsLinux 
                                        ? `(brave-browser "${data.target_url}" || brave "${data.target_url}" || firefox "${data.target_url}" || xdg-open "${data.target_url}") >/dev/null 2>&1 &` 
                                        : (osIsMac ? `open -a "Brave Browser" "${data.target_url}"` : `Start-Process brave -ArgumentList "${data.target_url}" -ErrorAction SilentlyContinue; if (!$?) { Start-Process "${data.target_url}" }`);
                                } else if (selectedBrowser === 'Firefox') {
                                    script = osIsLinux 
                                        ? `(firefox "${data.target_url}" || brave-browser "${data.target_url}" || xdg-open "${data.target_url}") >/dev/null 2>&1 &` 
                                        : (osIsMac ? `open -a "Firefox" "${data.target_url}"` : `Start-Process firefox -ArgumentList "${data.target_url}" -ErrorAction SilentlyContinue; if (!$?) { Start-Process "${data.target_url}" }`);
                                } else if (selectedBrowser === 'Chrome' || selectedBrowser === 'Google Chrome') {
                                    script = osIsLinux 
                                        ? `(google-chrome "${data.target_url}" || google-chrome-stable "${data.target_url}" || chromium-browser "${data.target_url}" || brave-browser "${data.target_url}" || firefox "${data.target_url}" || xdg-open "${data.target_url}") >/dev/null 2>&1 &` 
                                        : (osIsMac ? `open -a "Google Chrome" "${data.target_url}"` : `Start-Process chrome -ArgumentList "${data.target_url}" -ErrorAction SilentlyContinue; if (!$?) { Start-Process "${data.target_url}" }`);
                                } else if (selectedBrowser === 'Chromium') {
                                    script = osIsLinux 
                                        ? `(chromium-browser "${data.target_url}" || chromium "${data.target_url}" || brave-browser "${data.target_url}" || firefox "${data.target_url}" || xdg-open "${data.target_url}") >/dev/null 2>&1 &` 
                                        : (osIsMac ? `open -a "Chromium" "${data.target_url}"` : `Start-Process chromium -ArgumentList "${data.target_url}" -ErrorAction SilentlyContinue; if (!$?) { Start-Process "${data.target_url}" }`);
                                } else {
                                    script = data.shell_script 
                                        ? (osIsLinux ? `(${data.shell_script}) >/dev/null 2>&1 &` : data.shell_script) 
                                        : (osIsLinux ? `(brave-browser "${data.target_url}" || firefox "${data.target_url}" || xdg-open "${data.target_url}") >/dev/null 2>&1 &` : (osIsMac ? `open "${data.target_url}"` : `Start-Process "${data.target_url}"`));
                                }
                                
                                updateLifecycle({ Intent: 'completed', Policy: 'completed', Plan: 'completed', Execute: 'active', Verify: 'pending' });

                                const execRes = await fetch('http://localhost:8003/execute', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ script, approved: true })
                                });
                                const execData = await execRes.json();
                                statusSpan.className = "ml-2 text-emerald-400 font-bold text-xs";
                                statusSpan.innerText = "🚀 Opened on Host!";

                                updateLifecycle(
                                    { Intent: 'completed', Policy: 'completed', Plan: 'completed', Execute: 'completed', Verify: 'completed' },
                                    '✅ EXECUTED & VERIFIED',
                                    {
                                        risk: '✅ VERIFIED SAFE',
                                        safetySummary: 'Browser Launched',
                                        safetyDetail: 'Target URL opened on host successfully.',
                                        executionMode: '🌐 BROWSER OPERATION (LAUNCHED)'
                                    }
                                );
                            } else {
                                statusSpan.className = "ml-2 text-slate-400 font-bold text-xs";
                                statusSpan.innerText = "🛑 Cancelled";
                                updateLifecycle(
                                    { Intent: 'completed', Policy: 'completed', Plan: 'completed', Execute: 'blocked', Verify: 'pending' },
                                    '🛑 CANCELLED',
                                    {
                                        risk: '🛑 ACTION CANCELLED',
                                        safetySummary: 'Browser Launch Cancelled',
                                        safetyDetail: 'User did not authorize opening the browser.'
                                    }
                                );
                            }
                        } else if (data.shell_script) {
                            const { isConfirmed } = await Swal.fire({
                                title: 'Authorize & Execute Command?',
                                html: `<p class="text-slate-300 text-sm mb-2">OmniShell generated this verified command for your host:</p><pre class="text-left text-xs bg-slate-950 p-3 rounded-xl text-emerald-400 font-mono overflow-x-auto">${data.shell_script.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>`,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonText: '⚡ Authorize & Run',
                                cancelButtonText: 'Cancel',
                                background: '#0f172a',
                                color: '#fff',
                                confirmButtonColor: '#10b981',
                                cancelButtonColor: '#64748b',
                            });

                            if (isConfirmed) {
                                statusSpan.innerText = "🚀 Executing on Host...";
                                updateLifecycle({ Intent: 'completed', Policy: 'completed', Plan: 'completed', Execute: 'active', Verify: 'pending' }, '🚀 EXECUTING');

                                const execRes = await fetch('http://localhost:8003/execute', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        script: data.shell_script,
                                        expected_process: data.expected_process,
                                        approved: true
                                    })
                                });
                                const execData = await execRes.json();
                                const isSuccess = execData.success !== false;

                                statusSpan.className = isSuccess ? "ml-2 text-emerald-400 font-bold text-xs" : "ml-2 text-rose-400 font-bold text-xs";
                                statusSpan.innerText = isSuccess ? '✅ Executed + Verified on Host' : '❌ Execution failed';

                                // Advance Request Control Plane Lifecycle
                                updateLifecycle(
                                    {
                                        Intent: 'completed',
                                        Policy: 'completed',
                                        Plan: 'completed',
                                        Execute: isSuccess ? 'completed' : 'failed',
                                        Verify: isSuccess ? 'completed' : 'failed'
                                    },
                                    isSuccess ? '✅ EXECUTED & VERIFIED' : '❌ EXECUTION FAILED',
                                    {
                                        risk: isSuccess ? '✅ AUTHORIZED & EXECUTED' : '⚠️ FAILED',
                                        safetySummary: isSuccess ? 'Authorization Granted - Executed on Host' : 'Execution Failed',
                                        safetyDetail: isSuccess ? 'Host executor completed command with exit code 0.' : 'Command execution failed on host.',
                                        executionMode: '⚡ HOST EXECUTION (COMPLETED)'
                                    }
                                );

                                if (execData.output || execData.stdout || execData.stderr) {
                                    const outText = execData.output || execData.stdout || execData.stderr || '';
                                    const outputDiv = document.createElement('div');
                                    outputDiv.className = "terminal-output-box mt-4 p-4 bg-black text-green-400 font-mono text-xs rounded-xl border border-green-900 overflow-auto whitespace-pre-wrap w-full max-h-64 shadow-inner";
                                    outputDiv.innerText = `> ${data.shell_script}\n\n${outText.trim()}`;
                                    statusDiv.parentElement.parentElement.appendChild(outputDiv);
                                }

                                if (data.log_id) {
                                    fetch(`http://localhost:8000/api/execution-logs/${data.log_id}/result`, {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ result: execData, output: execData.output || execData.stdout || "" })
                                    }).catch(()=>{});
                                }
                            } else {
                                statusSpan.className = "ml-2 text-slate-400 font-bold text-xs";
                                statusSpan.innerText = "🛑 Cancelled";
                                updateLifecycle(
                                    { Intent: 'completed', Policy: 'completed', Plan: 'completed', Execute: 'blocked', Verify: 'pending' },
                                    '🛑 CANCELLED',
                                    {
                                        risk: '🛑 AUTHORIZATION DENIED',
                                        safetySummary: 'User Cancelled Execution',
                                        safetyDetail: 'The operation was cancelled by user choice and not sent to host.'
                                    }
                                );
                            }
                        }
                    } catch (e) {
                        console.warn("Host Executor offline", e);
                        statusSpan.className = "ml-2 text-slate-400 text-xs";
                        statusSpan.innerText = "(Host Executor offline)";
                    }
                }

                // Render Mermaid Diagram
                if (data.mermaid_diagram_body) {
                    const container = document.getElementById('mermaid-container');
                    try {
                        let mermaidBody = data.mermaid_diagram_body
                            .replace(/graph TD;?\n?/g, '')
                            .replace(/```mermaid/g, '')
                            .replace(/```/g, '')
                            .replace(/\[\[/g, '[')
                            .replace(/\]\]/g, ']')
                            .trim();
                        
                        const fullMermaidString = `graph TD;\n${mermaidBody}`;
                        const existingChart = document.getElementById('mermaid-chart');
                        if (existingChart) existingChart.remove();
                        
                        const { svg } = await window.mermaid.render('mermaid-chart', fullMermaidString);
                        container.innerHTML = svg;
                    } catch(err) {
                        console.error('Mermaid render failed:', err);
                        try {
                            const fallbackDiagram = `graph TD;\nP[User Prompt] --> A1[Intent Syndicate];\nA1 --> A2[Guardrail Security];\nA2 --> A3[Execution Pipeline];\nA3 --> A4[Host Verification];`;
                            const existingChart2 = document.getElementById('mermaid-chart');
                            if (existingChart2) existingChart2.remove();
                            const { svg } = await window.mermaid.render('mermaid-chart', fallbackDiagram);
                            container.innerHTML = svg;
                        } catch(e2) {
                            container.innerHTML = `<div class="text-slate-500 text-xs">Diagram rendered.</div>`;
                        }
                    }
                }

            } catch (err) {
                const banner = document.getElementById('error-banner');
                banner.innerText = err.message || 'Network error';
                banner.classList.remove('hidden');
            } finally {
                document.getElementById('btn-text').innerText = 'Execute';
                document.getElementById('btn-spinner').classList.add('hidden');
            }
        });

        // Clarification prompt submission
        async function submitClarification(clarifiedAnswer) {
            const promptInput = document.getElementById('prompt-input');
            const cleanText = (clarifiedAnswer || '').replace(/^[👉\s]+/, '').trim();
            if (cleanText) {
                promptInput.value = cleanText;
                const genBtn = document.getElementById('generate-btn');
                if (genBtn) genBtn.click();
            }
        }

        // Multi-Step Execution handler
        async function executeMultiStepPlan(steps) {
            const runMultiBtn = document.getElementById('run-multistep-btn');
            if (!runMultiBtn) return;
            runMultiBtn.disabled = true;
            runMultiBtn.innerHTML = `
                <svg class="animate-spin h-3.5 w-3.5 text-white mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                Executing Steps...
            `;
            try {
                const res = await fetch('http://localhost:8003/execute/multi-step', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ steps })
                });
                const data = await res.json();
                runMultiBtn.disabled = false;
                runMultiBtn.innerText = data.overall_success ? "✅ All Steps Passed" : "❌ Step Failed";
                
                const existingBoxes = document.querySelectorAll('.multistep-terminal-output');
                existingBoxes.forEach(b => b.remove());

                const outputDiv = document.createElement('div');
                outputDiv.className = "multistep-terminal-output terminal-output-box mt-4 p-4 bg-slate-950 text-emerald-400 font-mono text-xs rounded-2xl border border-sky-900/60 overflow-auto whitespace-pre-wrap w-full max-h-72 shadow-2xl";
                outputDiv.innerText = JSON.stringify(data.results || data, null, 2);
                document.getElementById('multistep-card').appendChild(outputDiv);

                updateLifecycle(
                    {
                        Intent: 'completed',
                        Policy: 'completed',
                        Plan: 'completed',
                        Execute: data.overall_success ? 'completed' : 'failed',
                        Verify: data.overall_success ? 'completed' : 'failed'
                    },
                    data.overall_success ? '✅ EXECUTED & VERIFIED' : '❌ EXECUTION FAILED',
                    {
                        risk: data.overall_success ? '✅ VERIFIED SAFE' : '⚠️ FAILED',
                        safetySummary: data.overall_success ? 'Multi-Step Plan Executed' : 'Step Execution Failed',
                        safetyDetail: data.overall_success ? 'All steps completed successfully on host.' : 'One or more steps failed during execution.',
                        executionMode: '⚡ MULTI-STEP HOST EXECUTION (COMPLETED)'
                    }
                );
            } catch (e) {
                runMultiBtn.disabled = false;
                runMultiBtn.innerText = "❌ Host Offline";
            }
        }

        // Auto-load and execute prompt from URL parameter (e.g. from /pipeline or /analytics)
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const promptParam = urlParams.get('prompt');
            if (promptParam && promptParam.trim()) {
                const promptInput = document.getElementById('prompt-input');
                if (promptInput) {
                    promptInput.value = promptParam.trim();
                    setTimeout(() => {
                        const genBtn = document.getElementById('generate-btn');
                        if (genBtn) genBtn.click();
                    }, 120);
                }
            }
        });
    </script>
</body>
</html>
